// Meeting events in a chat, drawn as Teams draws them: a centred card per call ("Meeting ended ·
// 1h 3m 12s" with who took part), per recording (Play opens it in the browser) and a small
// transcript row. "View recap" opens the meeting chat's Recap tab. The cards are built by
// `backend/meeting_cards.rs`.
import { Theme } from "theme.slint";
import { Avatar, Icon } from "widgets.slint";
import { MeetingCard } from "types.slint";
import { FindStore } from "find.slint";
import { RecapsStore } from "apps_store.slint";

// A text button of a meeting card.
component CardButton inherits Rectangle {
    in property <string> label;
    in property <string> a11y: root.label;
    in property <bool> primary;
    callback clicked();
    height: 28px;
    width: label-text.preferred-width + 24px;
    border-radius: 4px;
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border;
    background: root.primary ? (touch.has-hover ? Theme.accent : Theme.accent-strong) : (touch.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.a11y;
    accessible-action-default => { root.clicked(); }
    label-text := Text {
        text: root.label;
        color: root.primary ? #ffffff : Theme.fg;
        font-size: 12px * Theme.font-scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MeetingCardView inherits Rectangle {
    in property <MeetingCard> card;
    callback open-url(string);
    property <bool> slim: root.card.kind == "transcript";
    property <bool> recording: root.card.kind == "recording";
    height: row.preferred-height;
    accessible-role: groupbox;
    accessible-label: root.card.title;
    accessible-description: root.card.detail;

    function open-recap() {
        FindStore.chat-tab = "recap";
        RecapsStore.command("recaps-chat", root.card.recap-chat);
    }

    row := HorizontalLayout {
        alignment: center;
        Rectangle {
            width: min(root.slim ? 360px : 460px, root.width);
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.sidebar;
            VerticalLayout {
                padding: root.slim ? 6px : 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: root.slim ? 24px : 40px;
                            height: self.width;
                            border-radius: 6px;
                            background: root.recording && root.card.state == "ready" ? Theme.accent-strong : Theme.surface-hover;
                            Icon {
                                source: root.recording ? @image-url("icons/play.svg") : root.card.kind == "call" ? @image-url("icons/video.svg") : @image-url("icons/file.svg");
                                width: root.slim ? 14px : 20px;
                                height: self.width;
                                tint: root.recording && root.card.state == "ready" ? #ffffff : Theme.fg-muted;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.card.title;
                            color: Theme.fg;
                            font-size: (root.slim ? 12px : 13px) * Theme.font-scale;
                            font-weight: 600;
                            overflow: elide;
                        }
                        if root.card.detail != "": Text {
                            text: root.card.detail;
                            color: root.card.state == "failed" ? Theme.danger : Theme.fg-muted;
                            font-size: 12px * Theme.font-scale;
                            overflow: elide;
                        }
                    }
                    if root.card.url != "": VerticalLayout {
                        alignment: center;
                        CardButton {
                            label: @tr("Play");
                            a11y: @tr("Play {}", root.card.title);
                            primary: true;
                            clicked => { root.open-url(root.card.url); }
                        }
                    }
                    if root.card.recap-chat != "": VerticalLayout {
                        alignment: center;
                        CardButton {
                            label: root.slim ? @tr("Open") : @tr("View recap");
                            a11y: @tr("View recap");
                            clicked => { root.open-recap(); }
                        }
                    }
                }
                if root.card.people.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for p in root.card.people: Avatar {
                        initials: p.initials;
                        tone: p.color;
                        size: 24px;
                    }
                    if root.card.more > 0: Text {
                        text: "+" + root.card.more;
                        color: Theme.fg-muted;
                        font-size: 12px * Theme.font-scale;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
