// "More reactions": a searchable emoji grid. The rows come from Rust (`reactions.rs`), which
// owns the Teams reaction keys.
import { Theme } from "theme.slint";
import { EmojiItem } from "types.slint";
import { Icon } from "widgets.slint";

export component ReactionPicker inherits Rectangle {
    in property <[EmojiItem]> items;
    in-out property <string> query;
    in-out property <int> focus-tick;
    callback search(string);
    callback pick(string);

    width: 308px;
    height: 300px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000090;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Icon { source: @image-url("icons/search.svg"); width: 16px; height: 16px; y: 8px; }
                input := TextInput {
                    property <int> tick: root.focus-tick;
                    color: Theme.fg;
                    font-size: 13px * Theme.font-scale;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-placeholder-text: "Search reactions";
                    init => { self.focus(); }
                    changed tick => { self.focus(); }
                    edited => {
                        root.query = self.text;
                        root.search(self.text);
                    }
                }
            }
            if input.text == "": Text {
                x: 32px;
                text: "Search reactions";
                color: Theme.fg-subtle;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
        Flickable {
            content-height: grid.preferred-height;
            grid := GridLayout {
                spacing: 2px;
                for e[i] in root.items: Rectangle {
                    row: floor(i / 8);
                    col: mod(i, 8);
                    width: 34px;
                    height: 34px;
                    border-radius: 4px;
                    background: cell.has-hover ? Theme.surface-hover : transparent;
                    Text { text: e.emoji; font-size: 20px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                    cell := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: e.name;
                        clicked => { root.pick(e.key); }
                    }
                }
            }
        }
        if root.items.length == 0: Text {
            text: "No reactions found";
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            horizontal-alignment: center;
        }
    }
}
