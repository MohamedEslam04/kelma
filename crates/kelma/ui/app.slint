// kelma main window: Teams-like dark layout (rail, chat list, conversation, composer).
// The pieces live in sibling modules; this file keeps the AppWindow state, callbacks and wiring.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActivityRow, ChatRow, ComposerEmoji, EmojiItem, Msg, PendingAttachment, Recipient, TeamRow } from "types.slint";
import { Avatar, Icon, IconButton } from "widgets.slint";
import { Sidebar } from "sidebar.slint";
import { MessageRow } from "message_row.slint";
import { Composer, EmojiApi } from "composer.slint";
import { MessageMenu } from "message_menu.slint";
import { ReactionPicker } from "reaction_picker.slint";
import { ForwardDialog } from "forward_dialog.slint";
import { SelectBar } from "select_bar.slint";
import { LoginView } from "login.slint";
import { CalendarView, JoinBanner, CalStore } from "calendar.slint";
import { ActivityView } from "activity.slint";
import { PeopleStore } from "people.slint";
import { NewChatPane } from "new_chat.slint";
import { ParticipantsPanel, LeaveConfirm } from "participants.slint";
import { PinnedBanner } from "pinned_banner.slint";
import { ProfileCard } from "profile_card.slint";
import { OneDriveView, DriveStore } from "onedrive.slint";

export { Theme } from "theme.slint";
export { PersonItem, PinnedItem, ActivityRow, ChatRow, ReactionItem, EmojiItem, ComposerEmoji, Edited, PendingAttachment, Recipient, FileItem, ImageItem, Msg, ChannelRow, TeamRow } from "types.slint";
export { EmojiApi } from "composer.slint";
export { MentionApi } from "mention_picker.slint";
export { PeopleStore } from "people.slint";
export { CalStore, CalForm, CalDay, CalBlock, CalAllDay, CalMonthItem, CalMonthCell, CalMiniCell, CalFilterOpt, CalCalendarRow, CalSavedView, CalSettingsData, CalPerm, CalPeek, CalAttendeeRow, CalAttachmentRow, CalProposalRow, CalDetail, CalSchedRow, CalSuggest, CalRoomList, CalRoom } from "calendar.slint";
export { DriveStore, DriveRow, DriveNav, SharePerson, SharePerm, DriveVersion } from "onedrive.slint";

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("icons/app.svg");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.main;
    default-font-size: 14px;

    // --- state set from Rust ---
    in property <string> login-state: "checking"; // checking | code | error | ready
    in property <string> user-code;
    in property <string> verify-url;
    in property <string> login-error;
    in property <string> me-initials;
    in property <bool> connected: true;
    in property <string> banner;

    in-out property <string> view: "chat"; // chat | teams | activity | calendar | onedrive
    in-out property <string> filter: "all";
    in property <[ChatRow]> chats-favorites;
    in property <[ChatRow]> chats-main;
    in property <[ChatRow]> chats-channels;
    in property <[TeamRow]> teams;
    in property <string> current-id;
    in property <string> current-title;
    in property <string> current-initials;
    in property <color> current-color: Theme.accent-strong;
    in property <image> current-avatar;
    in property <bool> current-has-avatar;
    in property <bool> current-is-channel;
    in property <string> thread-root;     // non-empty: viewing a channel thread
    in property <[Msg]> messages;
    in property <string> typing;
    in property <bool> loading-older;
    in-out property <string> reply-author;
    in-out property <string> reply-preview;
    in-out property <string> editing-id;
    in-out property <string> draft;
    in-out property <string> post-subject;
    // The message list sits at the newest message. Set by the list itself; Rust is told.
    in-out property <bool> at-bottom: true;
    // New messages that arrived while scrolled up (the jump button shows the count).
    in property <int> new-count;
    // Row of the "New messages" divider to scroll to when a chat opens there.
    in property <int> divider-index: -1;

    // Message menu, "More reactions" picker, forward dialog and multi-select (see the
    // message_menu, reaction_picker, forward_dialog and select_bar modules).
    in-out property <bool> menu-open: false;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <Msg> menu-msg;
    in-out property <bool> picker-open: false;
    in-out property <length> picker-x;
    in-out property <length> picker-y;
    in-out property <string> picker-msg-id;
    in property <[EmojiItem]> picker-items;
    in-out property <bool> forward-open: false;
    in property <[Recipient]> forward-results;
    in property <[Recipient]> forward-picked;
    in-out property <int> forward-count: 1;
    in-out property <string> forward-preview-author;
    in-out property <string> forward-preview-text;
    in-out property <bool> select-mode: false;
    in property <int> select-count;

    // Activity view
    in property <[ActivityRow]> activity-items;
    in property <int> activity-unread;
    in property <int> chats-unread;
    in-out property <string> activity-filter: "all";
    in-out property <string> activity-selected;
    in property <string> activity-preview-id;
    in property <string> activity-preview-title;
    in property <string> activity-preview-location;
    in property <bool> activity-preview-is-channel;
    in property <bool> activity-preview-loading;
    in property <[Msg]> activity-preview;
    in property <string> activity-highlight;
    // Unread Activity items plus unread chats, like Teams; shown in the window title.
    out property <int> badge-total: root.activity-unread + root.chats-unread;
    out property <string> window-title: root.badge-total > 0 ? "(" + root.badge-total + ") kelma" : "kelma";
    in-out property <bool> enter-sends: true;
    in-out property <int> skin-tone: 0;
    in property <[ComposerEmoji]> recent-emoji;
    in property <[PendingAttachment]> pending-attachments;
    in property <int> cursor-tick; // Rust bumps it to put the composer cursor at the end

    // --- callbacks to Rust ---
    callback retry-login();
    callback copy-code();
    callback select-chat(string);
    callback select-channel(string, string);
    callback toggle-team(int);
    callback toggle-favorite(string);
    callback set-filter(string);
    callback search(string);
    callback send(string);
    callback typing-tick();
    callback draft-edited(string);
    callback load-older();
    callback react(string, string);
    callback reply(string);
    callback cancel-reply();
    callback edit(string);
    callback delete(string);
    callback open-url(string);
    callback open-thread(string);
    callback close-thread();
    callback attach-image();
    callback attach-file();
    callback set-enter-sends(bool);
    callback emoji-used(string);
    callback paste-image();
    callback remove-attachment(int);
    callback skin-tone-changed(int);
    callback dismiss-banner();
    callback picker-search(string);
    callback copy-link(string);
    callback toggle-save(string);
    callback pin(string);
    callback mark-unread(string);
    callback forward-begin(string);
    callback forward-begin-selected();
    callback forward-search(string);
    callback forward-toggle(string);
    callback forward-send(string);
    callback forward-cancel();
    callback select-begin(string);
    callback toggle-select(string);
    callback select-cancel();
    callback at-bottom-changed(bool);
    // Chat list "Mark as unread" (the message menu has its own `mark-unread(message id)`).
    callback mark-chat-unread(string);
    callback mark-all-read();
    callback jump-to-newest();
    callback retry-send(string);
    callback discard-send(string);
    // The chat header's "Schedule a meeting": opens the calendar's new-event form with the chat's members.
    callback schedule-meeting(string);
    callback activity-refresh();
    callback activity-select(string);
    callback activity-set-filter(string);
    callback activity-search(string);
    callback activity-mark(string, bool);
    callback activity-mark-all();
    callback activity-go-to();
    callback activity-reply(string);
    callback activity-settings();

    // Group chat header: renaming in place (the pencil).
    in-out property <bool> renaming: false;
    in-out property <string> rename-text;

    // Rust bumps these counters to request a scroll to the bottom / composer focus.
    in-out property <int> scroll-tick;
    in-out property <int> focus-tick;
    in-out property <int> divider-tick;


    if root.login-state != "ready": LoginView {
        state: root.login-state;
        user-code: root.user-code;
        verify-url: root.verify-url;
        error: root.login-error;
        copy-code => { root.copy-code(); }
        open-url(u) => { root.open-url(u); }
        retry => { root.retry-login(); }
    }

    if root.login-state == "ready": FocusScope {
        // Shift+Esc marks every chat read, wherever the focus is. The Activity view handles it
        // itself (marks every Activity item read).
        capture-key-pressed(event) => {
            if (event.text == Key.Escape && event.modifiers.shift && root.view != "activity") {
                root.mark-all-read();
                return accept;
            }
            // Alt+Shift+N: New chat.
            if ((event.text == "N" || event.text == "n") && event.modifiers.alt && event.modifiers.shift) {
                root.view = "chat";
                PeopleStore.new-chat-open = true;
                PeopleStore.command("new-chat-open", "");
                return accept;
            }
            reject
        }
        VerticalLayout {
        // Top bar with search
        Rectangle {
            height: 48px;
            background: Theme.topbar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                HorizontalLayout {
                    width: 260px;
                    spacing: 8px;
                    Image { source: @image-url("icons/logo.svg"); colorize: Theme.accent; width: 22px; height: 22px; y: 13px; }
                    Text { text: "kelma"; color: Theme.fg; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                }
                Rectangle {
                    height: 32px;
                    y: 8px;
                    min-width: 280px;
                    max-width: 640px;
                    horizontal-stretch: 2;
                    border-radius: 4px;
                    background: search-input.has-focus ? #1f1f1f : #292929;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Icon { source: @image-url("icons/search.svg"); width: 16px; height: 16px; y: 8px; }
                        search-input := TextInput {
                            color: Theme.fg;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search(self.text); }
                        }
                    }
                    if search-input.text == "": Text {
                        x: 36px;
                        text: "Search chats";
                        color: Theme.fg-subtle;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.connected: Text { text: "Reconnecting…"; color: #ffb900; font-size: 12px; vertical-alignment: center; }
                Avatar { initials: root.me-initials; size: 30px; y: 9px; }
            }
        }

        if CalStore.join-text != "": JoinBanner { }

        HorizontalLayout {
            // Left rail
            Rectangle {
                width: 68px;
                background: Theme.rail;
                VerticalLayout {
                    padding-top: 8px;
                    spacing: 4px;
                    alignment: start;
                    for item in [{key: "activity", label: "Activity", icon: @image-url("icons/activity.svg")}, {key: "chat", label: "Chat", icon: @image-url("icons/chat.svg")}, {key: "teams", label: "Teams", icon: @image-url("icons/teams.svg")}, {key: "calendar", label: "Calendar", icon: @image-url("icons/calendar.svg")}, {key: "onedrive", label: "OneDrive", icon: @image-url("icons/cloud.svg")}]: ri := Rectangle {
                        property <int> badge-count: item.key == "activity" ? root.activity-unread : (item.key == "chat" ? root.chats-unread : 0);
                        height: 56px;
                        Rectangle {
                            x: 0;
                            width: 3px;
                            height: 32px;
                            y: 12px;
                            border-radius: 2px;
                            background: root.view == item.key ? Theme.accent : transparent;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Icon { source: item.icon; tint: root.view == item.key || rt.has-hover ? Theme.accent : Theme.fg-muted; width: 22px; height: 22px; x: (parent.width - 22px) / 2; }
                            Text { text: item.label; color: root.view == item.key ? Theme.accent : Theme.fg-muted; font-size: 10px; horizontal-alignment: center; }
                        }
                        if ri.badge-count > 0: Rectangle {
                            x: parent.width / 2 + 2px;
                            y: 4px;
                            height: 16px;
                            width: max(16px, badge-text.preferred-width + 8px);
                            border-radius: 8px;
                            background: Theme.unread-badge;
                            accessible-role: text;
                            accessible-label: ri.badge-count + " unread";
                            badge-text := Text { text: ri.badge-count > 99 ? "99+" : ri.badge-count; color: #ffffff; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        rt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view = item.key;
                                if item.key == "activity" { root.activity-refresh(); }
                                if item.key == "onedrive" { DriveStore.command("enter", ""); }
                            }
                        }
                    }
                }
            }

            // Sidebar
            if root.view != "calendar" && root.view != "onedrive": Sidebar {
                visible: root.view != "activity";
                width: root.view == "activity" ? 0px : 320px;
                max-height: 100000px;
                view: root.view;
                filter <=> root.filter;
                chats-favorites: root.chats-favorites;
                chats-main: root.chats-main;
                chats-channels: root.chats-channels;
                teams: root.teams;
                current-id: root.current-id;
                mark-unread(id) => { root.mark-chat-unread(id); }
                mark-all-read => { root.mark-all-read(); }
                leave-chat(id) => { PeopleStore.leave-confirm = id; }
                new-chat => {
                    PeopleStore.new-chat-open = true;
                    PeopleStore.command("new-chat-open", "");
                }
                select-chat(id) => { root.select-chat(id); }
                select-channel(id, title) => { root.select-channel(id, title); }
                toggle-team(i) => { root.toggle-team(i); }
                toggle-favorite(id) => { root.toggle-favorite(id); }
                set-filter(f) => { root.set-filter(f); }
            }

            if root.view == "calendar": CalendarView { horizontal-stretch: 1; }
            if root.view == "onedrive": OneDriveView { horizontal-stretch: 1; }

            // Conversation
            if root.view != "calendar" && root.view != "onedrive": Rectangle {
                background: Theme.main;
                if root.view == "activity": ActivityView {
                    z: 20;
                    width: parent.width;
                    height: parent.height;
                    items: root.activity-items;
                    unread-count: root.activity-unread;
                    filter <=> root.activity-filter;
                    selected-id <=> root.activity-selected;
                    preview-id: root.activity-preview-id;
                    preview-title: root.activity-preview-title;
                    preview-location: root.activity-preview-location;
                    preview-is-channel: root.activity-preview-is-channel;
                    preview-loading: root.activity-preview-loading;
                    preview: root.activity-preview;
                    highlight: root.activity-highlight;
                    banner: root.banner;
                    select(id) => { root.activity-select(id); }
                    set-filter(f) => { root.activity-set-filter(f); }
                    search(q) => { root.activity-search(q); }
                    mark(id, read) => { root.activity-mark(id, read); }
                    mark-all => { root.activity-mark-all(); }
                    go-to => { root.view = "chat"; root.activity-go-to(); }
                    send-reply(t) => { root.activity-reply(t); }
                    open-url(u) => { root.open-url(u); }
                    notification-settings => { root.activity-settings(); }
                    dismiss-banner => { root.dismiss-banner(); }
                }
                if PeopleStore.new-chat-open && root.view != "activity": NewChatPane {
                    z: 30;
                    width: parent.width;
                    height: parent.height;
                    to: PeopleStore.new-chat-to;
                    results: PeopleStore.new-chat-results;
                    hint: PeopleStore.new-chat-hint;
                    query(q) => { PeopleStore.command("new-chat-query", q); }
                    add(id) => { PeopleStore.command("new-chat-add", id); }
                    remove(id) => { PeopleStore.command("new-chat-remove", id); }
                    name(n) => { PeopleStore.command("new-chat-name", n); }
                    send(t) => { PeopleStore.command("new-chat-send", t); }
                    close => {
                        PeopleStore.new-chat-open = false;
                        PeopleStore.command("new-chat-close", "");
                    }
                }
                if root.current-id == "": VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/chat.svg"); colorize: #3d3d3d; width: 96px; height: 96px; x: (parent.width - 96px) / 2; }
                    Text { text: "Select a chat to start messaging"; color: Theme.fg-subtle; horizontal-alignment: center; }
                }
                if root.banner != "": Rectangle {
                    z: 10;
                    x: (parent.width - self.width) / 2;
                    y: 70px;
                    width: min(parent.width - 40px, banner-text.preferred-width + 60px);
                    height: 36px;
                    border-radius: 6px;
                    background: #3b1f22;
                    border-width: 1px;
                    border-color: Theme.danger;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 8px;
                        banner-text := Text { text: root.banner; color: #ffffff; font-size: 12px; vertical-alignment: center; overflow: elide; }
                        IconButton { icon: @image-url("icons/close.svg"); size: 24px; y: 6px; clicked => { root.dismiss-banner(); } }
                    }
                }
                if root.current-id != "": VerticalLayout {
                    // Header
                    Rectangle {
                        height: 60px;
                        background: Theme.sidebar;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 16px;
                            spacing: 12px;
                            if root.thread-root != "": IconButton { icon: @image-url("icons/back.svg"); y: 14px; clicked => { root.close-thread(); } }
                            Avatar {
                                y: 12px;
                                initials: root.current-initials;
                                tone: root.current-color;
                                img: root.current-avatar;
                                has-img: root.current-has-avatar;
                                size: 36px;
                            }
                            if !root.renaming || root.thread-root != "": Text {
                                text: root.thread-root != "" ? "Thread" : root.current-title;
                                color: Theme.fg;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                            }
                            if root.renaming && root.thread-root == "": Rectangle {
                                y: 14px;
                                height: 32px;
                                width: 260px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: #1f1f1f;
                                border-width: 1px;
                                border-color: Theme.accent;
                                FocusScope {
                                    capture-key-pressed(event) => {
                                        if event.text == Key.Escape {
                                            root.renaming = false;
                                            return accept;
                                        }
                                        if event.text == Key.Return {
                                            root.renaming = false;
                                            PeopleStore.command("rename", rename-input.text);
                                            return accept;
                                        }
                                        reject
                                    }
                                    rename-input := TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text <=> root.rename-text;
                                        color: Theme.fg;
                                        font-size: 15px;
                                        single-line: true;
                                        vertical-alignment: center;
                                        accessible-role: text-input;
                                        accessible-label: "Group name";
                                        init => { self.focus(); self.select-all(); }
                                    }
                                }
                            }
                            if PeopleStore.header-group && root.thread-root == "" && !root.renaming: rename-btn := IconButton {
                                icon: @image-url("icons/edit.svg");
                                tooltip: "Rename chat";
                                size: 28px;
                                y: 16px;
                                clicked => {
                                    root.rename-text = root.current-title;
                                    root.renaming = true;
                                }
                            }
                            for tab in (root.current-is-channel ? ["Posts", "Files"] : ["Chat", "Shared"]): VerticalLayout {
                                alignment: center;
                                Text { text: tab; color: tab == "Chat" || tab == "Posts" ? Theme.fg : Theme.fg-muted; font-size: 14px; font-weight: tab == "Chat" || tab == "Posts" ? 600 : 400; }
                                Rectangle { height: 3px; border-radius: 1px; background: tab == "Chat" || tab == "Posts" ? Theme.accent : transparent; }
                            }
                            if root.thread-root == "" && !root.current-is-channel: IconButton {
                                icon: @image-url("icons/calendar.svg");
                                y: 14px;
                                tooltip: "Schedule a meeting";
                                clicked => { root.schedule-meeting(root.current-id); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if PeopleStore.header-group && root.thread-root == "": people-btn := Rectangle {
                                width: people-count.preferred-width + 40px;
                                height: 32px;
                                y: 14px;
                                horizontal-stretch: 0;
                                border-radius: 4px;
                                background: people-touch.has-hover || PeopleStore.participants-open ? Theme.surface-hover : transparent;
                                accessible-role: button;
                                accessible-label: "Participants";
                                Icon { source: @image-url("icons/people.svg"); x: 8px; y: 8px; width: 16px; height: 16px; tint: Theme.fg-muted; }
                                people-count := Text { x: 30px; text: PeopleStore.member-count; color: Theme.fg-muted; font-size: 13px; vertical-alignment: center; }
                                people-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        PeopleStore.participants-open = true;
                                        PeopleStore.command("participants-open", "");
                                    }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: #2b2b2b; }
                    }

                    if PeopleStore.pinned.length > 0 && root.thread-root == "": PinnedBanner {
                        items: PeopleStore.pinned;
                        index <=> PeopleStore.pinned-index;
                        jump(id) => { PeopleStore.command("pin-jump", id); }
                        unpin(id) => { PeopleStore.command("pin-unpin", id); }
                    }

                    // Messages
                    Rectangle {
                        vertical-stretch: 1;
                        msg-list := ListView {
                            property <int> tick: root.scroll-tick;
                            property <int> d-tick: root.divider-tick;
                            // Stay pinned to the newest message while content grows (images loading).
                            property <bool> pinned: true;
                            // After a jump to the divider its real position corrects the estimate
                            // (rows that are not on screen only have an estimated height).
                            property <bool> aligning: false;
                            changed pinned => {
                                root.at-bottom = self.pinned;
                                root.at-bottom-changed(self.pinned);
                            }
                            changed tick => {
                                self.pinned = true;
                                self.content-y = min(0px, self.visible-height - self.content-height);
                            }
                            changed d-tick => {
                                self.aligning = true;
                                self.content-y = min(0px, 24px - self.content-height * root.divider-index / max(1, root.messages.length));
                            }
                            changed content-height => {
                                if self.pinned {
                                    self.content-y = min(0px, self.visible-height - self.content-height);
                                }
                            }
                            changed content-y => {
                                self.pinned = self.content-y <= self.visible-height - self.content-height + 80px;
                                if self.content-y > -40px && self.content-height > self.visible-height + 40px && !self.pinned && root.messages.length > 0 && !root.loading-older && !self.aligning {
                                    root.load-older();
                                }
                            }
                                for m in root.messages: MessageRow {
                                    m: m;
                                    max-bubble: min(720px, msg-list.width * 0.75);
                                    in-channel: root.current-is-channel && root.thread-root == "";
                                    select-mode: root.select-mode;
                                    changed y => {
                                        if msg-list.aligning && (m.new-above || m.flash) {
                                            msg-list.content-y = min(0px, 24px - self.y);
                                        }
                                    }
                                    react(k) => { root.react(m.id, k); }
                                    reply => { root.reply(m.id); }
                                    edit => { root.edit(m.id); }
                                    more-reactions(x, y) => {
                                        root.picker-msg-id = m.id;
                                        root.picker-x = x;
                                        root.picker-y = y;
                                        root.picker-open = true;
                                        root.picker-search("");
                                    }
                                    menu(x, y) => {
                                        root.menu-msg = m;
                                        root.menu-x = x;
                                        root.menu-y = y;
                                        root.menu-open = true;
                                    }
                                    toggle-select => { root.toggle-select(m.id); }
                                    retry-send => { root.retry-send(m.id); }
                                    discard-send => { root.discard-send(m.id); }
                                    open-url(u) => { root.open-url(u); }
                                    open-thread => { root.open-thread(m.id); }
                                    open-image(u) => { root.open-url(u); }
                                    profile(id) => {
                                        if id != "" {
                                            PeopleStore.command("profile", id);
                                        }
                                    }
                                }
                        }
                        Timer {
                            interval: 700ms;
                            running: msg-list.aligning;
                            triggered => { msg-list.aligning = false; }
                        }
                        if !root.at-bottom && root.messages.length > 0: Rectangle {
                            z: 5;
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - 12px;
                            width: jump-text.preferred-width + 28px;
                            height: 32px;
                            border-radius: 16px;
                            background: jump-touch.has-hover ? Theme.accent-strong : Theme.accent;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000080;
                            jump-text := Text {
                                text: root.new-count > 0 ? "↓ Jump to newest · " + root.new-count : "↓ Jump to newest";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            jump-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.scroll-tick += 1;
                                    root.jump-to-newest();
                                }
                            }
                        }
                        if root.loading-older: Rectangle {
                            y: 8px;
                            height: 24px;
                            width: 200px;
                            x: (parent.width - 200px) / 2;
                            border-radius: 12px;
                            background: Theme.surface;
                            Text { text: "Loading older messages…"; color: Theme.fg-muted; font-size: 12px; }
                        }
                    }

                    if root.typing != "": HorizontalLayout {
                        padding-left: 24px;
                        Text { text: root.typing; color: Theme.fg-muted; font-size: 12px; }
                    }

                    if root.select-mode: SelectBar {
                        count: root.select-count;
                        forward => {
                            root.forward-count = root.select-count;
                            root.forward-preview-author = "";
                            root.forward-preview-text = "";
                            root.forward-open = true;
                            root.forward-begin-selected();
                        }
                        cancel => {
                            root.select-mode = false;
                            root.select-cancel();
                        }
                    }

                    // Composer
                    Composer {
                        vertical-stretch: 0;
                        current-is-channel: root.current-is-channel;
                        thread-root: root.thread-root;
                        reply-author: root.reply-author;
                        reply-preview: root.reply-preview;
                        editing-id: root.editing-id;
                        draft <=> root.draft;
                        post-subject <=> root.post-subject;
                        focus-tick <=> root.focus-tick;
                        enter-sends <=> root.enter-sends;
                        set-enter-sends(on) => { root.set-enter-sends(on); }
                        skin-tone <=> root.skin-tone;
                        recent-emoji: root.recent-emoji;
                        pending-attachments: root.pending-attachments;
                        paste-image => { root.paste-image(); }
                        remove-attachment(i) => { root.remove-attachment(i); }
                        cursor-tick: root.cursor-tick;
                        emoji-used(e) => { root.emoji-used(e); }
                        skin-tone-changed(t) => { root.skin-tone-changed(t); }
                        send(text) => { root.send(text); }
                        typing-tick => { root.typing-tick(); }
                        draft-edited(text) => { root.draft-edited(text); }
                        cancel-reply => { root.cancel-reply(); }
                        attach-image => { root.attach-image(); }
                        attach-file => { root.attach-file(); }
                    }
                }
            }
        }
    }
    }

    if root.login-state == "ready" && root.menu-open: Rectangle {
        width: root.width;
        height: root.height;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.menu-open = false;
                }
            }
        }
        msg-menu := MessageMenu {
            x: max(8px, min(root.menu-x, root.width - self.width - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            mine: root.menu-msg.mine;
            saved: root.menu-msg.saved;
            can-pin: !root.current-is-channel;
            reply => { root.menu-open = false; root.reply(root.menu-msg.id); }
            forward-one => {
                root.menu-open = false;
                root.forward-count = 1;
                root.forward-preview-author = root.menu-msg.sender;
                root.forward-preview-text = root.menu-msg.plain;
                root.forward-open = true;
                root.forward-begin(root.menu-msg.id);
            }
            forward-many => {
                root.menu-open = false;
                root.select-mode = true;
                root.select-begin(root.menu-msg.id);
            }
            copy-link => { root.menu-open = false; root.copy-link(root.menu-msg.id); }
            toggle-save => { root.menu-open = false; root.toggle-save(root.menu-msg.id); }
            pin => { root.menu-open = false; root.pin(root.menu-msg.id); }
            mark-unread => { root.menu-open = false; root.mark-unread(root.menu-msg.id); }
            edit => { root.menu-open = false; root.edit(root.menu-msg.id); }
            delete => { root.menu-open = false; root.delete(root.menu-msg.id); }
        }
    }

    if root.login-state == "ready" && root.picker-open: Rectangle {
        width: root.width;
        height: root.height;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.picker-open = false;
                }
            }
        }
        ReactionPicker {
            x: max(8px, min(root.picker-x, root.width - self.width - 8px));
            y: max(8px, min(root.picker-y, root.height - self.height - 8px));
            items: root.picker-items;
            search(q) => { root.picker-search(q); }
            pick(key) => {
                root.picker-open = false;
                root.react(root.picker-msg-id, key);
            }
        }
    }

    if root.login-state == "ready" && root.forward-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { }
        ForwardDialog {
            x: (root.width - self.width) / 2;
            y: max(8px, (root.height - self.height) / 2);
            results: root.forward-results;
            picked: root.forward-picked;
            count: root.forward-count;
            preview-author: root.forward-preview-author;
            preview-text: root.forward-preview-text;
            search(q) => { root.forward-search(q); }
            toggle(id) => { root.forward-toggle(id); }
            send(note) => { root.forward-send(note); }
            cancel => {
                root.forward-open = false;
                root.forward-cancel();
            }
        }
    }

    if root.login-state == "ready" && PeopleStore.participants-open: Rectangle {
        width: root.width;
        height: root.height;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    PeopleStore.participants-open = false;
                }
            }
        }
        ParticipantsPanel {
            x: root.width - self.width - 16px;
            y: 108px;
            members: PeopleStore.members;
            add-results: PeopleStore.add-results;
            open-profile(id) => {
                PeopleStore.participants-open = false;
                PeopleStore.command("profile", id);
            }
            add-query(q) => { PeopleStore.command("add-query", q); }
            add-pick(id) => { PeopleStore.command("add-pick", id); }
            history-changed(on) => { PeopleStore.command("add-history", on ? "on" : "off"); }
            leave => {
                PeopleStore.participants-open = false;
                PeopleStore.leave-confirm = root.current-id;
            }
            close => { PeopleStore.participants-open = false; }
        }
    }

    if root.login-state == "ready" && PeopleStore.leave-confirm != "": Rectangle {
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { }
        LeaveConfirm {
            x: (root.width - self.width) / 2;
            y: max(8px, (root.height - self.height) / 2);
            confirm => {
                PeopleStore.command("leave", PeopleStore.leave-confirm);
                PeopleStore.leave-confirm = "";
            }
            cancel => { PeopleStore.leave-confirm = ""; }
        }
    }

    if root.login-state == "ready" && PeopleStore.card-open: Rectangle {
        width: root.width;
        height: root.height;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    PeopleStore.card-open = false;
                }
            }
        }
        ProfileCard {
            x: (root.width - self.width) / 2;
            y: max(8px, min(160px, root.height - self.height - 8px));
            person: PeopleStore.card;
            loading: PeopleStore.card-loading;
            email: PeopleStore.card-email;
            work: PeopleStore.card-work;
            location: PeopleStore.card-location;
            local-time: PeopleStore.card-time;
            copy-email => { PeopleStore.command("profile-copy-email", ""); }
            chat(id) => {
                PeopleStore.card-open = false;
                PeopleStore.command("profile-chat", id);
            }
            send-email(e) => { root.open-url("mailto:" + e); }
            close => { PeopleStore.card-open = false; }
        }
    }
}
