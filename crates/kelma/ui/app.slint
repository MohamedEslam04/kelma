// kelma main window: Teams-like dark layout (rail, chat list, conversation, composer).
import { ScrollView, ListView } from "std-widgets.slint";

export global Theme {
    out property <color> rail: #0f0f0f;
    out property <color> sidebar: #1f1f1f;
    out property <color> main: #141414;
    out property <color> topbar: #0f0f0f;
    out property <color> surface: #292929;
    out property <color> surface-hover: #333333;
    out property <color> selected: #2e2e2e;
    out property <color> border: #3d3d3d;
    out property <color> accent: #7f85f5;
    out property <color> accent-strong: #5b5fc7;
    out property <color> fg: #ffffff;
    out property <color> fg-muted: #adadad;
    out property <color> fg-subtle: #8a8a8a;
    out property <color> bubble-mine: #2f2f4a;
    out property <color> bubble-other: #292929;
    out property <color> mention: #b4b8ff;
    out property <color> danger: #d13438;
    out property <color> unread-badge: #c4314b;
    out property <length> radius: 6px;
}

export struct ChatRow {
    id: string,
    title: string,
    preview: string,
    time: string,
    unread: bool,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    section: string, // "favorites" | "chats" | "channels"
    rtl-title: bool,
    rtl-preview: bool,
    favorite: bool,
}

export struct ReactionItem { key: string, emoji: string, count: int, mine: bool }
export struct FileItem { name: string, url: string, ext: string }
export struct ImageItem { url: string, img: image, loaded: bool, w: length, h: length }

export struct Msg {
    id: string,
    sender: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    mine: bool,
    time: string,
    day: string,           // non-empty: draw a date separator above
    show-header: bool,     // first message of a run from the same sender
    edited: bool,
    deleted: bool,
    system: bool,          // member added, call ended, ...
    subject: string,
    quote-author: string,
    quote-text: string,
    body: styled-text,
    plain: string,
    rtl: bool,
    images: [ImageItem],
    files: [FileItem],
    reactions: [ReactionItem],
    reply-count: int,
    pending: bool,
}

export struct ChannelRow { id: string, name: string, unread: bool }
export struct TeamRow { id: string, name: string, initials: string, color: color, expanded: bool, channels: [ChannelRow] }

component Icon inherits Image {
    in property <color> tint: Theme.fg-muted;
    width: 20px;
    height: 20px;
    colorize: tint;
    image-fit: contain;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <length> size: 32px;
    in property <color> tint: Theme.fg-muted;
    in property <bool> active: false;
    callback clicked();
    width: size;
    height: size;
    border-radius: 4px;
    background: touch.has-hover || active ? Theme.surface-hover : transparent;
    Icon {
        source: root.icon;
        tint: touch.has-hover || root.active ? Theme.accent : root.tint;
        width: root.size * 0.6;
        height: root.size * 0.6;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tone: Theme.accent-strong;
    in property <image> img;
    in property <bool> has-img: false;
    in property <length> size: 32px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: root.has-img ? transparent : root.tone;
    clip: true;
    if !root.has-img: Text {
        text: root.initials;
        color: #ffffff;
        font-size: root.size * 0.38;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-img: Image {
        source: root.img;
        width: root.size;
        height: root.size;
        image-fit: cover;
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border;
    background: active ? #3b3d6b : (t.has-hover ? Theme.surface-hover : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.label; color: Theme.fg; font-size: 12px; vertical-alignment: center; }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionHeader inherits Rectangle {
    in property <string> label;
    in-out property <bool> expanded: true;
    height: 30px;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 4px;
        Icon { source: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
        Text { text: root.label; color: Theme.fg-muted; font-size: 13px; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.expanded = !root.expanded; } }
}

component ChatItem inherits Rectangle {
    in property <ChatRow> data;
    in property <bool> selected;
    callback clicked();
    callback toggle-favorite();
    height: 56px;
    border-radius: 4px;
    background: selected ? Theme.selected : (t.has-hover ? #262626 : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;
        Avatar {
            initials: root.data.initials;
            tone: root.data.color;
            img: root.data.avatar;
            has-img: root.data.has-avatar;
            size: 32px;
            y: (parent.height - 32px) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data.title;
                    color: Theme.fg;
                    font-size: 14px;
                    font-weight: root.data.unread ? 700 : 400;
                    overflow: elide;
                    horizontal-stretch: 1;
                    horizontal-alignment: root.data.rtl-title ? right : left;
                }
                Text { text: root.data.time; color: Theme.fg-subtle; font-size: 11px; horizontal-stretch: 0; vertical-alignment: center; }
            }
            Text {
                text: root.data.preview;
                color: root.data.unread ? Theme.fg : Theme.fg-subtle;
                font-weight: root.data.unread ? 600 : 400;
                font-size: 12px;
                overflow: elide;
                horizontal-alignment: root.data.rtl-preview ? right : left;
            }
        }
        if root.data.unread: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
            y: (parent.height - 8px) / 2;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        if t.has-hover || root.data.favorite: IconButton {
            x: parent.width - 30px;
            y: 2px;
            size: 22px;
            icon: @image-url("icons/star.svg");
            tint: root.data.favorite ? #ffd335 : Theme.fg-subtle;
            clicked => { root.toggle-favorite(); }
        }
    }
}

component ReactionChip inherits Rectangle {
    in property <ReactionItem> r;
    callback clicked();
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: r.mine ? Theme.accent : Theme.border;
    background: r.mine ? #34365c : Theme.surface;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 8px;
        spacing: 4px;
        Text { text: root.r.emoji; font-size: 13px; vertical-alignment: center; }
        Text { text: root.r.count; color: Theme.fg; font-size: 12px; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component FileCard inherits Rectangle {
    in property <FileItem> f;
    callback open();
    height: 56px;
    border-radius: 4px;
    background: ta.has-hover ? #333333 : #1f1f1f;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 36px;
            background: #ffffff;
            border-radius: 2px;
            Text { text: root.f.ext; color: #141414; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.f.name; color: Theme.fg; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: "Open in browser"; color: Theme.fg-muted; font-size: 11px; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
}

component MessageRow inherits TouchArea {
    in property <Msg> m;
    in property <length> max-bubble: 600px;
    in property <bool> in-channel: false;
    callback react(string);
    callback reply();
    callback edit();
    callback delete();
    callback open-url(string);
    callback open-thread();
    callback open-image(string);
    height: content.preferred-height;

    content := VerticalLayout {
        width: root.width;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: root.m.show-header || root.m.day != "" ? 10px : 2px;
        spacing: 4px;

        if root.m.day != "": HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
            Text { text: root.m.day; color: Theme.fg-muted; font-size: 12px; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
        }

        if root.m.system: Text {
            text: root.m.plain;
            color: Theme.fg-subtle;
            font-size: 12px;
            font-italic: true;
            horizontal-alignment: center;
        }

        if !root.m.system: HorizontalLayout {
            alignment: root.m.mine ? end : start;
            spacing: 10px;

            if !root.m.mine: Rectangle {
                width: 32px;
                if root.m.show-header: Avatar {
                    y: 0;
                    initials: root.m.initials;
                    tone: root.m.color;
                    img: root.m.avatar;
                    has-img: root.m.has-avatar;
                    size: 32px;
                }
            }

            bubble := Rectangle {
                max-width: root.max-bubble;
                border-radius: Theme.radius;
                background: root.m.mine ? Theme.bubble-mine : Theme.bubble-other;
                opacity: root.m.pending ? 0.6 : 1.0;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    if root.m.show-header || root.m.mine: HorizontalLayout {
                        spacing: 8px;
                        alignment: root.m.mine ? end : start;
                        if !root.m.mine: Text { text: root.m.sender; color: Theme.fg; font-size: 12px; font-weight: 600; }
                        Text { text: root.m.time; color: Theme.fg-subtle; font-size: 11px; }
                        if root.m.edited: Text { text: "Edited"; color: Theme.fg-subtle; font-size: 11px; }
                    }

                    if root.m.subject != "": Text {
                        text: root.m.subject;
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.m.quote-text != "": Rectangle {
                        background: #1f1f1f;
                        border-radius: 4px;
                        HorizontalLayout {
                            Rectangle { width: 3px; background: Theme.accent; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text { text: root.m.quote-author; color: Theme.fg-muted; font-size: 11px; font-weight: 600; }
                                Text { text: root.m.quote-text; color: Theme.fg-muted; font-size: 12px; wrap: word-wrap; max-height: 48px; overflow: elide; }
                            }
                        }
                    }

                    if root.m.deleted: Text { text: "This message has been deleted."; color: Theme.fg-subtle; font-italic: true; font-size: 13px; }

                    if !root.m.deleted && root.m.plain != "": StyledText {
                        text: root.m.body;
                        default-color: Theme.fg;
                        default-font-size: 14px;
                        link-color: Theme.accent;
                        selectable: true;
                        horizontal-alignment: root.m.rtl ? right : left;
                        link-clicked(url) => { root.open-url(url); }
                    }

                    for im in root.m.images: Rectangle {
                        width: im.w;
                        height: im.h;
                        border-radius: 4px;
                        background: #1f1f1f;
                        clip: true;
                        if im.loaded: Image { source: im.img; width: parent.width; height: parent.height; image-fit: contain; }
                        if !im.loaded: Text { text: "Loading image…"; color: Theme.fg-subtle; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-image(im.url); } }
                    }

                    for f in root.m.files: FileCard {
                        f: f;
                        min-width: 280px;
                        open => { root.open-url(f.url); }
                    }

                    if root.m.reactions.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for r in root.m.reactions: ReactionChip {
                            r: r;
                            clicked => { root.react(r.key); }
                        }
                    }

                    if root.in-channel && root.m.reply-count >= 0: Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            Icon { source: @image-url("icons/thread.svg"); width: 14px; height: 14px; tint: Theme.accent; y: 4px; }
                            Text {
                                text: root.m.reply-count == 0 ? "Reply" : (root.m.reply-count == 1 ? "1 reply" : root.m.reply-count + " replies");
                                color: Theme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(); } }
                    }
                }
            }
        }
    }

    if root.has-hover && !root.m.system && !root.m.deleted: Rectangle {
        x: root.m.mine ? parent.width - self.width - 28px : 70px;
        y: 0px;
        height: 32px;
        width: actions.preferred-width;
        border-radius: 4px;
        background: #2b2b2b;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000080;
        actions := HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 0px;
            for e in [{k: "like", t: "👍"}, {k: "heart", t: "❤️"}, {k: "laugh", t: "😆"}, {k: "surprised", t: "😮"}, {k: "sad", t: "😢"}, {k: "angry", t: "😡"}]: Rectangle {
                width: 30px;
                background: et.has-hover ? Theme.surface-hover : transparent;
                border-radius: 4px;
                Text { text: e.t; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                et := TouchArea { mouse-cursor: pointer; clicked => { root.react(e.k); } }
            }
            Rectangle { width: 1px; background: Theme.border; }
            IconButton { icon: @image-url("icons/reply.svg"); size: 30px; clicked => { root.reply(); } }
            if root.m.mine: IconButton { icon: @image-url("icons/edit.svg"); size: 30px; clicked => { root.edit(); } }
            if root.m.mine: IconButton { icon: @image-url("icons/trash.svg"); size: 30px; clicked => { root.delete(); } }
        }
    }
}

component LoginView inherits Rectangle {
    in property <string> state; // checking | code | error
    in property <string> user-code;
    in property <string> verify-url;
    in property <string> error;
    callback copy-code();
    callback open-url(string);
    callback retry();
    background: Theme.main;
    VerticalLayout {
        alignment: center;
        spacing: 18px;
        Image { source: @image-url("icons/logo.svg"); colorize: Theme.accent; width: 64px; height: 64px; x: (parent.width - 64px) / 2; }
        Text { text: "kelma"; color: Theme.fg; font-size: 28px; font-weight: 700; horizontal-alignment: center; }
        if root.state == "checking": Text { text: "Signing in…"; color: Theme.fg-muted; horizontal-alignment: center; }
        if root.state == "code": VerticalLayout {
            spacing: 12px;
            Text { text: "Open this page and enter the code to sign in:"; color: Theme.fg-muted; horizontal-alignment: center; }
            Text {
                text: root.verify-url;
                color: Theme.accent;
                horizontal-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-url(root.verify-url); } }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 6px;
                    width: code-text.preferred-width + 40px;
                    height: 56px;
                    code-text := Text { text: root.user-code; color: Theme.fg; font-size: 28px; font-weight: 700; letter-spacing: 4px; }
                }
                Rectangle {
                    width: 90px;
                    height: 56px;
                    border-radius: 6px;
                    background: ct.has-hover ? Theme.accent : Theme.accent-strong;
                    Text { text: "Copy"; color: #ffffff; font-weight: 600; }
                    ct := TouchArea { mouse-cursor: pointer; clicked => { root.copy-code(); } }
                }
            }
            Text { text: "Waiting for you to finish signing in…"; color: Theme.fg-subtle; font-size: 12px; horizontal-alignment: center; }
        }
        if root.state == "error": VerticalLayout {
            spacing: 12px;
            Text { text: root.error; color: Theme.danger; wrap: word-wrap; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: 6px;
                    background: Theme.accent-strong;
                    Text { text: "Try again"; color: #ffffff; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.retry(); } }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "kelma";
    icon: @image-url("icons/logo.svg");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.main;
    default-font-size: 14px;

    // --- state set from Rust ---
    in property <string> login-state: "checking"; // checking | code | error | ready
    in property <string> user-code;
    in property <string> verify-url;
    in property <string> login-error;
    in property <string> me-initials;
    in property <bool> connected: true;
    in property <string> banner;

    in-out property <string> view: "chat"; // chat | teams
    in-out property <string> filter: "all";
    in property <[ChatRow]> chats-favorites;
    in property <[ChatRow]> chats-main;
    in property <[ChatRow]> chats-channels;
    in property <[TeamRow]> teams;
    in property <string> current-id;
    in property <string> current-title;
    in property <string> current-initials;
    in property <color> current-color: Theme.accent-strong;
    in property <image> current-avatar;
    in property <bool> current-has-avatar;
    in property <bool> current-is-channel;
    in property <string> thread-root;     // non-empty: viewing a channel thread
    in property <[Msg]> messages;
    in property <string> typing;
    in property <bool> loading-older;
    in-out property <string> reply-author;
    in-out property <string> reply-preview;
    in-out property <string> editing-id;
    in-out property <string> draft;
    in-out property <string> post-subject;

    // --- callbacks to Rust ---
    callback retry-login();
    callback copy-code();
    callback select-chat(string);
    callback select-channel(string, string);
    callback toggle-team(int);
    callback toggle-favorite(string);
    callback set-filter(string);
    callback search(string);
    callback send(string);
    callback typing-tick();
    callback load-older();
    callback react(string, string);
    callback reply(string);
    callback cancel-reply();
    callback edit(string);
    callback delete(string);
    callback open-url(string);
    callback open-thread(string);
    callback close-thread();
    callback attach-image();
    callback attach-file();

    // Rust bumps these counters to request a scroll to the bottom / composer focus.
    in-out property <int> scroll-tick;
    in-out property <int> focus-tick;

    property <bool> favorites-open: true;
    property <bool> chats-open: true;
    property <bool> channels-open: true;
    property <bool> emoji-open: false;

    if root.login-state != "ready": LoginView {
        state: root.login-state;
        user-code: root.user-code;
        verify-url: root.verify-url;
        error: root.login-error;
        copy-code => { root.copy-code(); }
        open-url(u) => { root.open-url(u); }
        retry => { root.retry-login(); }
    }

    if root.login-state == "ready": VerticalLayout {
        // Top bar with search
        Rectangle {
            height: 48px;
            background: Theme.topbar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                HorizontalLayout {
                    width: 260px;
                    spacing: 8px;
                    Image { source: @image-url("icons/logo.svg"); colorize: Theme.accent; width: 22px; height: 22px; y: 13px; }
                    Text { text: "kelma"; color: Theme.fg; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                }
                Rectangle {
                    height: 32px;
                    y: 8px;
                    max-width: 720px;
                    border-radius: 4px;
                    background: search-input.has-focus ? #1f1f1f : #292929;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Icon { source: @image-url("icons/search.svg"); width: 16px; height: 16px; y: 8px; }
                        search-input := TextInput {
                            color: Theme.fg;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search(self.text); }
                        }
                    }
                    if search-input.text == "": Text {
                        x: 36px;
                        text: "Search chats";
                        color: Theme.fg-subtle;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.connected: Text { text: "Reconnecting…"; color: #ffb900; font-size: 12px; vertical-alignment: center; }
                Avatar { initials: root.me-initials; size: 30px; y: 9px; }
            }
        }

        HorizontalLayout {
            // Left rail
            Rectangle {
                width: 68px;
                background: Theme.rail;
                VerticalLayout {
                    padding-top: 8px;
                    spacing: 4px;
                    alignment: start;
                    for item in [{key: "chat", label: "Chat", icon: @image-url("icons/chat.svg")}, {key: "teams", label: "Teams", icon: @image-url("icons/teams.svg")}]: Rectangle {
                        height: 56px;
                        Rectangle {
                            x: 0;
                            width: 3px;
                            height: 32px;
                            y: 12px;
                            border-radius: 2px;
                            background: root.view == item.key ? Theme.accent : transparent;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Icon { source: item.icon; tint: root.view == item.key || rt.has-hover ? Theme.accent : Theme.fg-muted; width: 22px; height: 22px; x: (parent.width - 22px) / 2; }
                            Text { text: item.label; color: root.view == item.key ? Theme.accent : Theme.fg-muted; font-size: 10px; horizontal-alignment: center; }
                        }
                        rt := TouchArea { mouse-cursor: pointer; clicked => { root.view = item.key; } }
                    }
                }
            }

            // Sidebar
            Rectangle {
                width: 320px;
                background: Theme.sidebar;
                border-width: 0px;
                VerticalLayout {
                    HorizontalLayout {
                        height: 56px;
                        padding-left: 16px;
                        padding-right: 12px;
                        Text { text: root.view == "chat" ? "Chat" : "Teams"; color: Theme.fg; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    }
                    if root.view == "chat": HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        alignment: start;
                        Pill { label: "Unread"; active: root.filter == "unread"; clicked => { root.filter = root.filter == "unread" ? "all" : "unread"; root.set-filter(root.filter); } }
                        Pill { label: "Channels"; active: root.filter == "channels"; clicked => { root.filter = root.filter == "channels" ? "all" : "channels"; root.set-filter(root.filter); } }
                        Pill { label: "Chats"; active: root.filter == "chats"; clicked => { root.filter = root.filter == "chats" ? "all" : "chats"; root.set-filter(root.filter); } }
                    }
                    Rectangle { height: 1px; background: #2b2b2b; }

                    if root.view == "chat": ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;
                            alignment: start;
                            SectionHeader { label: "Favorites"; expanded <=> root.favorites-open; }
                            if root.favorites-open: VerticalLayout { for c in root.chats-favorites: ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                            } }
                            SectionHeader { label: "Chats"; expanded <=> root.chats-open; }
                            if root.chats-open: VerticalLayout { for c in root.chats-main: ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                            } }
                            SectionHeader { label: "Teams and channels"; expanded <=> root.channels-open; }
                            if root.channels-open: VerticalLayout { for c in root.chats-channels: ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                            } }
                        }
                    }

                    if root.view == "teams": ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            alignment: start;
                            for t[ti] in root.teams: VerticalLayout {
                                Rectangle {
                                    height: 44px;
                                    border-radius: 4px;
                                    background: tt.has-hover ? #262626 : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 10px;
                                        Icon { source: t.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; y: 15px; }
                                        Rectangle {
                                            width: 28px; height: 28px; y: 8px; border-radius: 4px; background: t.color;
                                            Text { text: t.initials; color: #ffffff; font-size: 12px; font-weight: 700; }
                                        }
                                        Text { text: t.name; color: Theme.fg; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                    }
                                    tt := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-team(ti); } }
                                }
                                if t.expanded: VerticalLayout {
                                    for ch in t.channels: Rectangle {
                                        height: 34px;
                                        border-radius: 4px;
                                        background: ch.id == root.current-id ? Theme.selected : (ct.has-hover ? #262626 : transparent);
                                        HorizontalLayout {
                                            padding-left: 50px;
                                            spacing: 6px;
                                            Text {
                                                text: ch.name;
                                                color: Theme.fg;
                                                font-size: 13px;
                                                font-weight: ch.unread ? 700 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        ct := TouchArea { mouse-cursor: pointer; clicked => { root.select-channel(ch.id, t.name + " › " + ch.name); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Conversation
            Rectangle {
                background: Theme.main;
                if root.current-id == "": VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/chat.svg"); colorize: #3d3d3d; width: 96px; height: 96px; x: (parent.width - 96px) / 2; }
                    Text { text: "Select a chat to start messaging"; color: Theme.fg-subtle; horizontal-alignment: center; }
                }
                if root.current-id != "": VerticalLayout {
                    // Header
                    Rectangle {
                        height: 60px;
                        background: Theme.sidebar;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 16px;
                            spacing: 12px;
                            if root.thread-root != "": IconButton { icon: @image-url("icons/back.svg"); y: 14px; clicked => { root.close-thread(); } }
                            Avatar {
                                y: 12px;
                                initials: root.current-initials;
                                tone: root.current-color;
                                img: root.current-avatar;
                                has-img: root.current-has-avatar;
                                size: 36px;
                            }
                            Text {
                                text: root.thread-root != "" ? "Thread" : root.current-title;
                                color: Theme.fg;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                            }
                            for tab in (root.current-is-channel ? ["Posts", "Files"] : ["Chat", "Shared"]): VerticalLayout {
                                alignment: center;
                                Text { text: tab; color: tab == "Chat" || tab == "Posts" ? Theme.fg : Theme.fg-muted; font-size: 14px; font-weight: tab == "Chat" || tab == "Posts" ? 600 : 400; }
                                Rectangle { height: 3px; border-radius: 1px; background: tab == "Chat" || tab == "Posts" ? Theme.accent : transparent; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: #2b2b2b; }
                    }

                    // Messages
                    Rectangle {
                        vertical-stretch: 1;
                        msg-list := ListView {
                            property <int> tick: root.scroll-tick;
                            changed tick => {
                                self.content-y = min(0px, self.visible-height - self.content-height);
                            }
                            changed content-y => {
                                if self.content-y > -40px && root.messages.length > 0 && !root.loading-older {
                                    root.load-older();
                                }
                            }
                                for m in root.messages: MessageRow {
                                    m: m;
                                    max-bubble: min(720px, msg-list.width * 0.75);
                                    in-channel: root.current-is-channel && root.thread-root == "";
                                    react(k) => { root.react(m.id, k); }
                                    reply => { root.reply(m.id); }
                                    edit => { root.edit(m.id); }
                                    delete => { root.delete(m.id); }
                                    open-url(u) => { root.open-url(u); }
                                    open-thread => { root.open-thread(m.id); }
                                    open-image(u) => { root.open-url(u); }
                                }
                        }
                        if root.loading-older: Rectangle {
                            y: 8px;
                            height: 24px;
                            width: 200px;
                            x: (parent.width - 200px) / 2;
                            border-radius: 12px;
                            background: Theme.surface;
                            Text { text: "Loading older messages…"; color: Theme.fg-muted; font-size: 12px; }
                        }
                    }

                    if root.typing != "": HorizontalLayout {
                        padding-left: 24px;
                        Text { text: root.typing; color: Theme.fg-muted; font-size: 12px; }
                    }

                    // Composer
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-bottom: 16px;
                        padding-top: 6px;
                        Rectangle {
                            border-radius: 6px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            VerticalLayout {
                                if root.reply-preview != "": Rectangle {
                                    background: #1f1f1f;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Rectangle { width: 3px; background: Theme.accent; }
                                        VerticalLayout {
                                            Text { text: root.editing-id != "" ? "Editing message" : "Replying to " + root.reply-author; color: Theme.fg-muted; font-size: 11px; font-weight: 600; }
                                            Text { text: root.reply-preview; color: Theme.fg-muted; font-size: 12px; overflow: elide; }
                                        }
                                        IconButton { icon: @image-url("icons/close.svg"); size: 24px; clicked => { root.cancel-reply(); } }
                                    }
                                }
                                if root.current-is-channel && root.thread-root == "": HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    height: 34px;
                                    TextInput {
                                        text <=> root.post-subject;
                                        color: Theme.fg;
                                        font-size: 15px;
                                        font-weight: 700;
                                        single-line: true;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    min-height: 44px;
                                    composer-scope := FocusScope {
                                        capture-key-pressed(event) => {
                                            if (event.text == Key.Return && !event.modifiers.shift) {
                                                if composer-input.text != "" {
                                                    root.send(composer-input.text);
                                                    composer-input.text = "";
                                                }
                                                return accept;
                                            }
                                            reject
                                        }
                                        composer-input := TextInput {
                                            property <int> tick: root.focus-tick;
                                            changed tick => { self.focus(); }
                                            x: 14px;
                                            y: 10px;
                                            width: parent.width - 28px;
                                            text <=> root.draft;
                                            color: Theme.fg;
                                            font-size: 14px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            edited => { root.typing-tick(); }
                                        }
                                    }
                                    if composer-input.text == "": Text {
                                        x: 14px;
                                        y: 10px;
                                        text: root.current-is-channel && root.thread-root == "" ? "Start a post" : "Type a message";
                                        color: Theme.fg-subtle;
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-bottom: 6px;
                                    spacing: 2px;
                                    alignment: end;
                                    IconButton { icon: @image-url("icons/emoji.svg"); clicked => { emoji-popup.show(); } }
                                    IconButton { icon: @image-url("icons/image.svg"); clicked => { root.attach-image(); } }
                                    IconButton { icon: @image-url("icons/attach.svg"); clicked => { root.attach-file(); } }
                                    Rectangle { width: 1px; background: Theme.border; }
                                    IconButton {
                                        icon: @image-url("icons/send.svg");
                                        tint: composer-input.text != "" ? Theme.accent : Theme.fg-subtle;
                                        clicked => {
                                            if composer-input.text != "" {
                                                root.send(composer-input.text);
                                                composer-input.text = "";
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                background: composer-input.has-focus ? Theme.accent : transparent;
                            }
                        }
                    }
                }

                emoji-popup := PopupWindow {
                    x: parent.width - 380px;
                    y: parent.height - 300px;
                    width: 320px;
                    height: 220px;
                    Rectangle {
                        background: #2b2b2b;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            for row in [["😀", "😂", "😊", "😍", "😎", "🤔", "😅", "😢"], ["😡", "👍", "👎", "👏", "🙏", "💪", "🎉", "🔥"], ["❤️", "💯", "✅", "❌", "👀", "🚀", "⭐", "☕"], ["😴", "🤝", "🙌", "😬", "🤯", "😇", "🥳", "💡"]]: HorizontalLayout {
                                for e in row: Rectangle {
                                    width: 36px;
                                    height: 44px;
                                    border-radius: 4px;
                                    background: ea.has-hover ? Theme.surface-hover : transparent;
                                    Text { text: e; font-size: 20px; }
                                    ea := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.draft = root.draft + e;
                                            root.focus-tick += 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
