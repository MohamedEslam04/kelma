// Workflows (read only): your flows and the run history of the selected one. kelma has no
// button that turns a flow on or off or runs it.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { FlowsStore, AppRow } from "apps_store.slint";
import { KitBadge, KitNote } from "apps_kit.slint";

component FlowRowView inherits Rectangle {
    in property <AppRow> f;
    callback clicked();
    height: 64px;
    border-radius: 4px;
    background: root.f.selected ? Theme.selected : (touch.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.f.title;
    accessible-description: root.f.badge + ", " + root.f.subtitle;
    accessible-item-selected: root.f.selected;
    Rectangle { x: 0; y: 14px; width: 3px; height: 36px; border-radius: 2px; background: root.f.selected ? Theme.accent : transparent; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            Text { text: root.f.title; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: root.f.subtitle; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
            Text { text: root.f.meta; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        KitBadge { y: 22px; text: root.f.badge; tone: root.f.tone; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component FlowsView inherits Rectangle {
    background: Theme.main;
    init => { FlowsStore.command("flows-enter", ""); }
    HorizontalLayout {
        Rectangle {
            width: 360px;
            background: Theme.sidebar;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Workflows"; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; }
                            Text { text: FlowsStore.environment; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                        }
                        IconButton { y: 12px; icon: @image-url("icons/sync.svg"); tooltip: "Refresh flows"; clicked => { FlowsStore.command("flows-refresh", ""); } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: parent.width - 12px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;
                        for f in FlowsStore.flows: FlowRowView {
                            f: f;
                            clicked => { FlowsStore.command("flows-select", f.id); }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: FlowsStore.selected-name == "" ? "Run history" : "Run history of " + FlowsStore.selected-name;
                        color: Theme.fg;
                        font-size: 16px * Theme.font-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            KitNote { text: "Read only. kelma does not turn flows on or off or run them; do that in Power Automate."; text-size: 12px; }
            if FlowsStore.loading: KitNote { text: "Loading…"; }
            if FlowsStore.status != "": KitNote { text: FlowsStore.status; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.width - 12px;
                    padding: 12px;
                    alignment: start;
                    for r in FlowsStore.runs: Rectangle {
                        height: 44px;
                        accessible-role: list-item;
                        accessible-label: r.title;
                        accessible-description: r.badge + ", " + r.subtitle;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text { text: r.title; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; width: 150px; }
                            Text { text: r.subtitle; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; width: 70px; }
                            Text { text: r.meta; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            KitBadge { y: 12px; text: r.badge; tone: r.tone; }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                }
            }
        }
    }
}
