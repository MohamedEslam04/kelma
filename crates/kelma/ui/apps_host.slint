// The app screens as one block. The window puts it over the area right of the rail while the view
// is one of the app views, so the chat views underneath stay as they are.
import { Theme } from "theme.slint";
import { AppsStore } from "apps_store.slint";
import { KitButton, AppTile } from "apps_kit.slint";
import { StoreView } from "apps_store_view.slint";
import { TasksView } from "apps_tasks.slint";
import { FlowsView } from "apps_flows.slint";
import { NotesView, ListsView } from "apps_notes.slint";

// An app kelma has no screen for: its page opens in Teams on the web.
component HostView inherits Rectangle {
    background: Theme.main;
    VerticalLayout {
        padding: 32px;
        spacing: 12px;
        alignment: start;
        Text { text: AppsStore.host-name; color: Theme.fg; font-size: 22px; font-weight: 700; wrap: word-wrap; }
        if AppsStore.host-blurb != "": Text { text: AppsStore.host-blurb; color: Theme.fg-muted; font-size: 14px; wrap: word-wrap; }
        Text {
            text: "kelma does not run this app itself. It opens in Teams on the web, in your browser.";
            color: Theme.fg-subtle;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            KitButton { label: "Open in Teams on the web"; primary: true; clicked => { AppsStore.command("app-link", "host"); } }
            for t in AppsStore.host-tabs: KitButton { label: t.label; clicked => { AppsStore.command("app-link", "tab:" + t.key); } }
        }
    }
}

export component AppsHost inherits Rectangle {
    in property <string> view;
    background: Theme.main;
    // Keep clicks and keys from reaching the chat views underneath.
    TouchArea { }
    if root.view == "store": StoreView { }
    if root.view == "planner": TasksView { }
    if root.view == "workflows": FlowsView { }
    if root.view == "onenote": NotesView { }
    if root.view == "lists": ListsView { }
    if root.view == "app": HostView { }
}
