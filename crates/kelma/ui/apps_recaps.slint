// Meeting Recaps: your recent meetings with a recording or transcript on the left; the selected
// meeting on the right with Play recording (the browser), the transcript, the meeting notes,
// Share (the OneDrive share dialog) and the AI recap, which needs Teams Premium or Copilot.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { RecapsStore } from "apps_store.slint";
import { KitButton, KitNote, KitSearch } from "apps_kit.slint";

component Heading inherits Text {
    color: Theme.fg;
    font-size: 14px * Theme.font-scale;
    font-weight: 700;
}

export component RecapsView inherits Rectangle {
    background: Theme.main;
    init => { RecapsStore.command("recaps-enter", ""); }
    HorizontalLayout {
        Rectangle {
            width: 340px;
            background: Theme.sidebar;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: "Meeting Recaps"; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        IconButton { y: 12px; icon: @image-url("icons/sync.svg"); tooltip: "Refresh meetings"; clicked => { RecapsStore.command("recaps-refresh", ""); } }
                    }
                }
                Rectangle {
                    height: 44px;
                    KitSearch {
                        x: 12px;
                        y: 4px;
                        width: parent.width - 24px;
                        placeholder: "Search for meetings";
                        label: "Search for meetings";
                        text <=> RecapsStore.query;
                        edited(q) => { RecapsStore.command("recaps-query", q); }
                    }
                }
                if RecapsStore.loading: KitNote { text: "Loading your meetings…"; }
                if RecapsStore.note != "": KitNote { text: RecapsStore.note; text-size: 12px; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: parent.width - 12px;
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        for m in RecapsStore.meetings: Rectangle {
                            height: 62px;
                            border-radius: 4px;
                            background: m.selected ? Theme.selected : (t.has-hover ? Theme.surface-hover : transparent);
                            accessible-role: button;
                            accessible-label: m.title;
                            accessible-description: m.subtitle + ", " + m.meta;
                            accessible-item-selected: m.selected;
                            Rectangle { x: 0; y: 10px; width: 3px; height: parent.height - 20px; border-radius: 2px; background: m.selected ? Theme.accent : transparent; }
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                alignment: center;
                                spacing: 2px;
                                Text { text: m.title; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: m.selected ? 700 : 600; overflow: elide; }
                                Text { text: m.subtitle; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
                                Text { text: m.meta; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                            }
                            t := TouchArea { mouse-cursor: pointer; clicked => { RecapsStore.command("recaps-open", m.id); } }
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        if !RecapsStore.detail-open: Rectangle {
            horizontal-stretch: 1;
            Text { text: "Pick a meeting to see its recording, transcript and notes."; color: Theme.fg-subtle; font-size: 14px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        }
        if RecapsStore.detail-open: ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                width: parent.width - 12px;
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Text { text: RecapsStore.detail-title; color: Theme.fg; font-size: 22px * Theme.font-scale; font-weight: 700; wrap: word-wrap; accessible-role: text; accessible-label: "Meeting " + RecapsStore.detail-title; }
                Text {
                    text: RecapsStore.detail-when + (RecapsStore.detail-when != "" && RecapsStore.detail-organizer != "" ? " · " : "") + RecapsStore.detail-organizer;
                    color: Theme.fg-muted;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    KitButton { label: "Play recording"; primary: true; enabled: RecapsStore.has-recording; clicked => { RecapsStore.command("recaps-play", ""); } }
                    KitButton { label: "Meeting notes"; enabled: RecapsStore.has-notes; clicked => { RecapsStore.command("recaps-notes", ""); } }
                    KitButton { label: "Share"; enabled: RecapsStore.can-share; clicked => { RecapsStore.command("recaps-share", ""); } }
                }
                if RecapsStore.notes-note != "": Text { text: RecapsStore.notes-note; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
                if RecapsStore.has-recording: Text { text: "kelma has no video player: Play recording opens it in your browser."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
                Heading { text: "Transcript"; }
                if RecapsStore.transcript-note != "": Text { text: RecapsStore.transcript-note; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
                if RecapsStore.transcript != "": Text { text: RecapsStore.transcript; color: Theme.fg; font-size: 13px * Theme.font-scale; wrap: word-wrap; accessible-role: text; accessible-label: "Transcript text"; }
                Heading { text: "AI recap: notes, tasks and chapters"; }
                Text { text: RecapsStore.ai; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; accessible-role: text; accessible-label: "AI recap " + RecapsStore.ai; }
                Text { text: "AI notes, suggested tasks and chapters need Teams Premium or Copilot."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
                if RecapsStore.has-ai-link: HorizontalLayout {
                    alignment: start;
                    KitButton { label: "Open the AI recap in Teams"; clicked => { RecapsStore.command("recaps-ai", ""); } }
                }
            }
        }
    }
}
