// The Calendar view: toolbar, mini month, day / work week / week time grid, month grid, and the
// Join banner. Everything it shows comes from the CalStore global, filled by the Rust backend.
import { Theme } from "theme.slint";
import { Icon, IconButton, Pill } from "widgets.slint";

export struct CalDay { iso: string, label: string, number: int, today: bool, weekend: bool }

export struct CalBlock {
    id: string,
    title: string,
    organizer: string,
    time: string,
    col: int,
    start-min: int,
    dur-min: int,
    lane: int,
    lanes: int,
    kind: string, // busy | tentative | free | oof | elsewhere
    declined: bool,
    private: bool,
    online: bool,
    recurring: bool,
    tone: color,
}

export struct CalAllDay {
    id: string,
    title: string,
    col: int,
    span: int,
    row: int,
    kind: string,
    declined: bool,
    private: bool,
    online: bool,
    recurring: bool,
    tone: color,
}

export struct CalMonthItem { title: string, time: string, declined: bool, tone: color }
export struct CalMonthCell { iso: string, number: int, in-month: bool, today: bool, items: [CalMonthItem], more: int }
export struct CalMiniCell { iso: string, number: int, in-month: bool, today: bool, selected: bool }

export global CalStore {
    in property <string> title;
    in property <string> view-kind: "workweek"; // day | workweek | week | month
    in property <int> day-count: 1;
    in property <int> scale: 30;
    in property <[CalDay]> days;
    in property <[CalBlock]> blocks;
    in property <[CalAllDay]> all-day;
    in property <int> all-day-rows;
    in property <[CalMonthCell]> month;
    in property <string> mini-title;
    in property <[CalMiniCell]> mini;
    // Minutes since local midnight and the column of today; -1 when today is not shown.
    in property <int> now-min: -1;
    in property <int> now-col: -1;
    in property <string> status;
    in property <string> join-text;
    in property <string> join-url;
    // (name, argument): today, prev, next, view, days, scale, goto, mini, join, dismiss-banner
    callback command(string, string);
}

// One event: a block in a day column, a bar in the all-day row, or a line in the month grid.
component CalBox inherits Rectangle {
    in property <string> title;
    in property <string> organizer;
    in property <string> time;
    in property <string> kind;
    in property <bool> declined;
    in property <bool> private;
    in property <bool> online;
    in property <bool> recurring;
    in property <color> tone;
    in property <bool> compact: false;
    border-radius: 4px;
    clip: true;
    background: root.kind == "free" ? transparent : (root.kind == "elsewhere" ? root.tone.with-alpha(0.35) : (root.kind == "tentative" ? root.tone.with-alpha(0.55) : root.tone));
    border-width: root.kind == "busy" || root.kind == "oof" ? 0px : 1px;
    border-color: root.tone;
    opacity: root.declined ? 0.65 : 1;

    // Tentative events are hatched.
    if root.kind == "tentative": Rectangle {
        background: @linear-gradient(135deg, #0000 0%, #0000 5%, #00000055 5%, #00000055 10%, #0000 10%, #0000 15%, #00000055 15%, #00000055 20%, #0000 20%, #0000 25%, #00000055 25%, #00000055 30%, #0000 30%, #0000 35%, #00000055 35%, #00000055 40%, #0000 40%, #0000 45%, #00000055 45%, #00000055 50%, #0000 50%, #0000 55%, #00000055 55%, #00000055 60%, #0000 60%, #0000 65%, #00000055 65%, #00000055 70%, #0000 70%, #0000 75%, #00000055 75%, #00000055 80%, #0000 80%, #0000 85%, #00000055 85%, #00000055 90%, #0000 90%, #0000 95%, #00000055 95%, #00000055 100%);
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: root.kind == "free" ? root.tone : root.tone.darker(0.35);
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        padding-top: 2px;
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                height: 15px;
                title-text := Text {
                    width: parent.width;
                    text: root.title;
                    color: root.kind == "free" ? Theme.fg : #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.declined: strike := Rectangle {
                    x: 0;
                    y: parent.height / 2;
                    width: min(title-text.preferred-width, title-text.width);
                    height: 1px;
                    background: title-text.color;
                }
            }
            if !root.compact && root.height >= 30px: Text {
                text: root.organizer;
                color: root.kind == "free" ? Theme.fg-muted : #ffffffcc;
                font-size: 11px;
                overflow: elide;
            }
            if !root.compact && root.height >= 46px: Text {
                text: root.time;
                color: root.kind == "free" ? Theme.fg-muted : #ffffffcc;
                font-size: 11px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 2px;
            padding-top: 2px;
            alignment: end;
            if root.private: Icon { source: @image-url("icons/lock.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
            if root.online: Icon { source: @image-url("icons/video.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
            if root.recurring: Icon { source: @image-url("icons/repeat.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
        }
    }
}

component TimeGrid inherits Rectangle {
    property <length> gutter: 52px;
    property <length> head-h: 46px;
    property <int> ncols: max(1, CalStore.days.length);
    property <length> col-w: (root.width - root.gutter) / root.ncols;
    property <length> pph: CalStore.scale == 15 ? 96px : (CalStore.scale == 60 ? 48px : 64px);
    property <int> slots: CalStore.scale == 15 ? 96 : (CalStore.scale == 60 ? 24 : 48);
    property <int> per-hour: CalStore.scale == 15 ? 4 : (CalStore.scale == 60 ? 1 : 2);
    property <length> allday-h: CalStore.all-day-rows > 0 ? CalStore.all-day-rows * 20px + 6px : 0px;

    init => { grid.content-y = -6.5 * root.pph; }

    // Day headers
    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.head-h;
        for d[i] in CalStore.days: Rectangle {
            x: root.gutter + i * root.col-w;
            width: root.col-w;
            height: parent.height;
            background: d.today ? #1c1c33 : transparent;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: d.label; color: d.today ? Theme.accent : Theme.fg-muted; font-size: 11px; horizontal-alignment: center; }
                Rectangle {
                    height: 24px;
                    today-marker := Rectangle {
                        width: 24px;
                        x: (parent.width - 24px) / 2;
                        border-radius: 12px;
                        background: d.today ? Theme.accent-strong : transparent;
                        Text { text: d.number; color: Theme.fg; font-size: 13px; font-weight: d.today ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // All-day row
    Rectangle {
        y: root.head-h;
        width: parent.width;
        height: root.allday-h;
        for a in CalStore.all-day: CalBox {
            compact: true;
            x: root.gutter + a.col * root.col-w + 2px;
            y: 3px + a.row * 20px;
            width: a.span * root.col-w - 4px;
            height: 18px;
            title: a.title;
            kind: a.kind;
            declined: a.declined;
            private: a.private;
            online: a.online;
            recurring: a.recurring;
            tone: a.tone;
            accessible-role: button;
            accessible-label: a.title;
        }
        Rectangle { y: parent.height - 1px; height: root.allday-h > 0px ? 1px : 0px; background: #2b2b2b; }
    }

    grid := Flickable {
        y: root.head-h + root.allday-h;
        height: root.height - self.y;
        content-height: 24 * root.pph;
        content-width: self.width;

        // Day columns
        for d[i] in CalStore.days: Rectangle {
            x: root.gutter + i * root.col-w;
            width: root.col-w;
            height: 24 * root.pph;
            background: d.today ? #17172a : (d.weekend ? #181818 : transparent);
        }
        // Slot lines
        for s in root.slots: Rectangle {
            x: root.gutter;
            y: s * 24 * root.pph / root.slots;
            width: root.width - root.gutter;
            height: 1px;
            background: Math.mod(s, root.per-hour) == 0 ? #3a3a3a : #262626;
        }
        for i in root.ncols + 1: Rectangle { x: root.gutter + i * root.col-w; width: 1px; height: 24 * root.pph; background: #2b2b2b; }
        // Hour labels
        for h in 24: Text {
            x: 0;
            y: h * root.pph - 7px;
            width: root.gutter - 8px;
            text: h == 0 ? "" : (h < 10 ? "0" + h + ":00" : h + ":00");
            color: Theme.fg-subtle;
            font-size: 11px;
            horizontal-alignment: right;
        }
        // Events
        for b in CalStore.blocks: CalBox {
            x: root.gutter + b.col * root.col-w + b.lane * ((root.col-w - 8px) / b.lanes) + 2px;
            y: b.start-min * root.pph / 60 + 1px;
            width: (root.col-w - 8px) / b.lanes - 2px;
            height: max(b.dur-min * root.pph / 60 - 2px, 16px);
            title: b.title;
            organizer: b.organizer;
            time: b.time;
            kind: b.kind;
            declined: b.declined;
            private: b.private;
            online: b.online;
            recurring: b.recurring;
            tone: b.tone;
            accessible-role: button;
            accessible-label: b.title;
            accessible-description: (b.declined ? "Declined. " : "") + b.time;
        }
        // Current time
        if CalStore.now-min >= 0: Rectangle {
            x: root.gutter;
            y: CalStore.now-min * root.pph / 60;
            width: root.width - root.gutter;
            height: 1px;
            background: #e5484d80;
        }
        if CalStore.now-min >= 0 && CalStore.now-col >= 0: now-line := Rectangle {
            x: root.gutter + CalStore.now-col * root.col-w;
            y: CalStore.now-min * root.pph / 60 - 1px;
            width: root.col-w;
            height: 2px;
            background: #e5484d;
            Rectangle { x: -4px; y: -3px; width: 8px; height: 8px; border-radius: 4px; background: #e5484d; }
        }
    }
}

component MonthGrid inherits Rectangle {
    property <length> head-h: 26px;
    property <int> rows: max(1, Math.round(CalStore.month.length / 7));
    property <length> cw: root.width / 7;
    property <length> ch: (root.height - root.head-h) / root.rows;

    for d[i] in CalStore.days: Text {
        x: i * root.cw;
        y: 0px;
        width: root.cw;
        height: root.head-h;
        text: d.label;
        color: Theme.fg-muted;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for c[i] in CalStore.month: Rectangle {
        x: Math.mod(i, 7) * root.cw;
        y: root.head-h + Math.floor(i / 7) * root.ch;
        width: root.cw;
        height: root.ch;
        background: c.today ? #17172a : (c.in-month ? transparent : #101010);
        border-width: 1px;
        border-color: #2b2b2b;
        clip: true;
        VerticalLayout {
            padding: 3px;
            spacing: 1px;
            Rectangle {
                height: 22px;
                Rectangle {
                    x: 2px;
                    width: 22px;
                    border-radius: 11px;
                    background: c.today ? Theme.accent-strong : transparent;
                    Text { text: c.number; color: c.in-month ? Theme.fg : Theme.fg-subtle; font-size: 12px; font-weight: c.today ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            for it in c.items: Rectangle {
                height: 16px;
                Rectangle { x: 2px; y: 5px; width: 6px; height: 6px; border-radius: 3px; background: it.tone; }
                month-title := Text {
                    x: 12px;
                    width: parent.width - 14px;
                    text: it.time == "" ? it.title : it.time + " " + it.title;
                    color: it.declined ? Theme.fg-subtle : Theme.fg;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if it.declined: Rectangle { x: 12px; y: parent.height / 2; width: min(month-title.preferred-width, month-title.width); height: 1px; background: Theme.fg-subtle; }
            }
            if c.more > 0: Text { text: "+" + c.more + " more"; color: Theme.fg-muted; font-size: 11px; }
        }
    }
}

component MiniMonth inherits Rectangle {
    property <length> cell: 28px;
    height: 36px + 20px + Math.round(CalStore.mini.length / 7) * root.cell + 8px;
    VerticalLayout {
        padding: 8px;
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            Text { text: CalStore.mini-title; color: Theme.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: @image-url("icons/chevron-left.svg"); size: 26px; y: 3px; clicked => { CalStore.command("mini", "-1"); } }
            IconButton { icon: @image-url("icons/chevron-right.svg"); size: 26px; y: 3px; clicked => { CalStore.command("mini", "1"); } }
        }
        Rectangle {
            height: 20px + Math.round(CalStore.mini.length / 7) * root.cell;
            for l[i] in ["M", "T", "W", "T", "F", "S", "S"]: Text {
                x: i * (parent.width / 7);
                y: 0px;
                width: parent.width / 7;
                height: 20px;
                text: l;
                color: Theme.fg-subtle;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            for c[i] in CalStore.mini: Rectangle {
                x: Math.mod(i, 7) * (parent.width / 7);
                y: 20px + Math.floor(i / 7) * root.cell;
                width: parent.width / 7;
                height: root.cell;
                background: c.selected ? #2b2d52 : transparent;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - 24px) / 2;
                    y: (parent.height - 24px) / 2;
                    border-radius: 12px;
                    background: c.today ? Theme.accent-strong : (mini-touch.has-hover ? Theme.surface-hover : transparent);
                    Text { text: c.number; color: c.today ? #ffffff : (c.in-month ? Theme.fg : Theme.fg-subtle); font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                mini-touch := TouchArea { mouse-cursor: pointer; clicked => { CalStore.command("goto", c.iso); } }
            }
        }
    }
}

export component CalendarView inherits Rectangle {
    background: Theme.main;
    HorizontalLayout {
        // Left: mini month, time scale, days
        Rectangle {
            width: 232px;
            background: Theme.sidebar;
            VerticalLayout {
                alignment: start;
                padding-top: 8px;
                MiniMonth { }
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Text { text: "Time scale"; color: Theme.fg-muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for s in [15, 30, 60]: Pill {
                            label: s + " min";
                            active: CalStore.scale == s;
                            clicked => { CalStore.command("scale", "" + s); }
                        }
                    }
                    if CalStore.view-kind == "day": HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Days"; color: Theme.fg-muted; font-size: 12px; vertical-alignment: center; }
                        IconButton { icon: @image-url("icons/chevron-left.svg"); size: 26px; clicked => { CalStore.command("days", "-1"); } }
                        Text { text: CalStore.day-count; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                        IconButton { icon: @image-url("icons/chevron-right.svg"); size: 26px; clicked => { CalStore.command("days", "1"); } }
                    }
                }
            }
        }
        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 48px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Pill { label: "Today"; y: 11px; clicked => { CalStore.command("today", ""); } }
                    IconButton { icon: @image-url("icons/chevron-left.svg"); y: 8px; clicked => { CalStore.command("prev", ""); } }
                    IconButton { icon: @image-url("icons/chevron-right.svg"); y: 8px; clicked => { CalStore.command("next", ""); } }
                    Text { text: CalStore.title; color: Theme.fg; font-size: 16px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 80px; }
                    if CalStore.status != "": Text { text: CalStore.status; color: #ffb900; font-size: 12px; vertical-alignment: center; }
                    for v in [{key: "day", label: "Day"}, {key: "workweek", label: "Work week"}, {key: "week", label: "Week"}, {key: "month", label: "Month"}]: Pill {
                        y: 11px;
                        label: v.label;
                        active: CalStore.view-kind == v.key;
                        clicked => { CalStore.command("view", v.key); }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: #2b2b2b; }
            }
            if CalStore.view-kind != "month": TimeGrid { vertical-stretch: 1; }
            if CalStore.view-kind == "month": MonthGrid { vertical-stretch: 1; }
        }
    }
}

// Shown above the app from 5 minutes before a Teams meeting until it ends.
export component JoinBanner inherits Rectangle {
    height: 40px;
    background: #1d3a2a;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Icon { source: @image-url("icons/video.svg"); tint: #6bd69b; y: 10px; }
        Text { text: CalStore.join-text; color: Theme.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        join-button := Rectangle {
            width: 64px;
            height: 26px;
            y: 7px;
            border-radius: 4px;
            background: join-touch.has-hover ? Theme.accent : Theme.accent-strong;
            Text { text: "Join"; color: #ffffff; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            join-touch := TouchArea { mouse-cursor: pointer; clicked => { CalStore.command("join", CalStore.join-url); } }
        }
        IconButton { icon: @image-url("icons/close.svg"); size: 26px; y: 7px; clicked => { CalStore.command("dismiss-banner", ""); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: #2f6b4a; }
}
