// The calendar's data and state: the structs the Rust backend fills in, the CalStore global the
// views read, and the CalForm global the new-event form edits. Kept apart from the views so the
// peek, form and dialog files can import it without an import cycle.

export struct CalDay { iso: string, label: string, number: int, today: bool, weekend: bool, pin: string }

export struct CalBlock {
    id: string,
    title: string,
    organizer: string,
    time: string,
    col: int,
    start-min: int,
    dur-min: int,
    lane: int,
    lanes: int,
    kind: string, // busy | tentative | free | oof | elsewhere
    declined: bool,
    private: bool,
    online: bool,
    recurring: bool,
    tone: color,
}

export struct CalAllDay {
    id: string,
    title: string,
    col: int,
    span: int,
    row: int,
    kind: string,
    declined: bool,
    private: bool,
    online: bool,
    recurring: bool,
    tone: color,
}

export struct CalMonthItem { id: string, title: string, time: string, declined: bool, tone: color }
export struct CalMonthCell { iso: string, number: int, in-month: bool, today: bool, items: [CalMonthItem], more: int }
export struct CalMiniCell { iso: string, number: int, in-month: bool, today: bool, selected: bool }

// One option of the filter panel; `group` is kind | show | rec | cat | place.
export struct CalFilterOpt { group: string, key: string, label: string, on: bool }
// A row of the calendars list: a group header, or a calendar with its color and checkbox.
export struct CalCalendarRow { id: string, name: string, owner: string, color: color, checked: bool, header: bool }
export struct CalSavedView { name: string, summary: string }
export struct CalSettingsData { first-day: int, work-start: string, work-end: string, weekends: bool, week-numbers: bool, second-tz: string }
export struct CalPerm { id: string, name: string, email: string, role: string, removable: bool }

// What the event peek shows, and decides which buttons it offers.
export struct CalPeek {
    id: string,
    title: string,
    when: string,
    location: string,
    organizer: string,
    counts: string,
    response: string, // organizer | accepted | tentative | declined | none
    show-as: string,
    category: string,
    can-respond: bool,
    has-join: bool,
    recurring: bool,
    private: bool,
    cancelled: bool,
    can-edit: bool,
    can-cancel: bool,
    can-delete: bool,
    has-attendees: bool,
}
export struct CalAttendeeRow { name: string, email: string, response: string, kind: string }
export struct CalAttachmentRow { name: string, size: string }
export struct CalDetail {
    id: string,
    loading: bool,
    error: string,
    body: string,
    attendees: [CalAttendeeRow],
    attachments: [CalAttachmentRow],
    dial-in: string,
    hide-attendees: bool,
}

// The scheduler grid: one row per person or room, one cell per slot (0 free, 1 tentative,
// 2 busy, 3 out of office, 4 working elsewhere, 5 unknown); `work` says per slot whether it is in
// that person's own work hours.
export struct CalSchedRow { name: string, email: string, tz: string, kind: string, cells: [int], work: [bool], error: string }
export struct CalSuggest { label: string, date: string, start: string, end: string, score: string }
export struct CalRoomList { name: string, email: string }
export struct CalRoom { name: string, email: string, capacity: string, place: string, status: int }

export global CalStore {
    in property <string> title;
    in property <string> view-kind: "workweek"; // day | workweek | week | month
    in property <int> day-count: 1;
    in property <int> scale: 30;
    in property <[CalDay]> days;
    in property <[CalBlock]> blocks;
    in property <[CalAllDay]> all-day;
    in property <int> all-day-rows;
    in property <[CalMonthCell]> month;
    in property <int> month-cols: 7;
    in property <string> mini-title;
    in property <[CalMiniCell]> mini;
    // The weekday letters over the mini calendar, starting at the first day of the week.
    in property <[string]> mini-heads: ["M", "T", "W", "T", "F", "S", "S"];
    // Week numbers (Calendar settings): one per month or mini-calendar row.
    in property <bool> week-numbers;
    in property <string> week-label;
    in property <[int]> month-weeks;
    in property <[int]> mini-weeks;
    // Work hours shade the rest of the day; the second time zone adds a column of hour labels.
    in property <int> work-start: 540;
    in property <int> work-end: 1020;
    in property <string> second-title;
    in property <[string]> second-labels;
    // Minutes since local midnight and the column of today; -1 when today is not shown.
    in property <int> now-min: -1;
    in property <int> now-col: -1;
    in property <string> status;
    in property <string> join-text;
    in property <string> join-url;

    in property <[CalFilterOpt]> filter-opts;
    in property <bool> filtered;
    in property <[CalCalendarRow]> calendars;
    in property <[CalSavedView]> saved-views;
    in property <CalSettingsData> settings;
    in property <[CalPerm]> perms;
    in property <string> share-note;

    // Which popover or dialog is open: popup is "" | new | range | filters | views | more |
    // add-calendar | work-location | join | peek-more | category; modal is "" | full | settings |
    // share | prompt | meet-link.
    in-out property <string> popup;
    in-out property <string> modal;
    // Where the peek opens, in view coordinates, and whether it is open.
    in-out property <bool> peek-open;
    // The peek's own dropdown: "" | join | showas | category | more.
    in-out property <string> peek-menu;
    in-out property <length> peek-x;
    in-out property <length> peek-y;
    in property <CalPeek> peek;
    in property <CalDetail> detail;
    in property <[string]> categories;
    // The first day picked in the date range picker, until the second is chosen.
    in-out property <string> range-start;

    // One dialog serves cancel, forward, delete, join with an ID, meet now and the like: the
    // confirm button sends `command(prompt-kind, text1|text2|check)`.
    in-out property <string> prompt-kind;
    in-out property <string> prompt-title;
    in-out property <string> prompt-message;
    in-out property <string> prompt-label1;
    in-out property <string> prompt-label2;
    in-out property <string> prompt-check-label;
    in-out property <string> prompt-confirm: "OK";
    in-out property <string> prompt-error;
    in-out property <string> prompt-text1;
    in-out property <string> prompt-text2;
    in-out property <bool> prompt-check;
    // The link of a Meet now meeting.
    in property <string> meet-link;

    // (name, argument): today, prev, next, view, days, scale, goto, mini, join, dismiss-banner,
    // and everything the peek, filters, calendars, settings and dialogs send; see CalCmd::parse.
    callback command(string, string);

    public function ask(kind: string, title: string, message: string, label1: string, label2: string, check: string, confirm: string) {
        root.prompt-kind = kind;
        root.prompt-title = title;
        root.prompt-message = message;
        root.prompt-label1 = label1;
        root.prompt-label2 = label2;
        root.prompt-check-label = check;
        root.prompt-confirm = confirm;
        root.prompt-error = "";
        root.prompt-text1 = "";
        root.prompt-text2 = "";
        root.prompt-check = false;
        root.popup = "";
        root.peek-menu = "";
        root.modal = "prompt";
    }

    public function close-all() {
        root.popup = "";
        root.modal = "";
        root.peek-open = false;
        root.peek-menu = "";
    }
}

// The new-event form. The Rust side fills it for a new, edited or duplicated event and reads it
// back on `submit`.
export global CalForm {
    in-out property <bool> open;
    in property <string> heading: "New event";
    in property <bool> editing;
    in property <bool> channel-mode;
    in property <string> error;
    in-out property <string> subject;
    in-out property <string> start-date;
    in-out property <string> start-time;
    in-out property <string> end-date;
    in-out property <string> end-time;
    in-out property <bool> all-day;
    in-out property <string> required;
    in-out property <string> optional;
    in-out property <bool> show-optional;
    in-out property <string> location;
    in-out property <string> room-name;
    in-out property <string> room-email;
    in-out property <bool> teams-meeting;
    // none | keep | daily | weekdays | weekly | monthly | monthly-nth | yearly
    in-out property <string> repeat: "none";
    in-out property <string> interval: "1";
    in-out property <[bool]> repeat-days: [false, false, false, false, false, false, false];
    in-out property <string> end-kind: "never"; // never | on | after
    in-out property <string> end-value;
    in-out property <string> body;
    in-out property <string> reminder: "default";
    in-out property <string> show-as: "busy";
    in-out property <bool> private;
    in-out property <string> category;
    in-out property <bool> response-requested: true;
    in-out property <bool> allow-proposals: true;
    in-out property <bool> hide-attendees;
    in-out property <string> channel;
    in property <[string]> channels;
    in property <[string]> categories;

    // Scheduler (C2.3)
    in-out property <bool> sched-open;
    in property <[CalSchedRow]> sched;
    in property <int> sched-first-min: 360;
    in property <int> sched-slot-min: 30;
    in property <bool> sched-loading;
    in property <string> sched-note;
    in property <[CalSuggest]> suggestions;
    // Rooms (C2.4)
    in-out property <bool> rooms-open;
    in property <[CalRoomList]> room-lists;
    in property <[CalRoom]> rooms;
    in property <bool> rooms-loading;
    in property <string> rooms-note;

    // The form's start and end as minutes after midnight (-1 when they do not parse), for the
    // Scheduler's outline; the Rust side keeps them current.
    in-out property <int> sel-start: -1;
    in-out property <int> sel-end: -1;
    callback times-edited();
    callback submit();
    callback cancel();
    // Rust writes the start and end back after a scheduler click or a suggestion.
    callback pick-slot(int);
    callback apply-suggestion(int);
    callback pick-room(int);
}

// Formatting and color helpers the calendar files share.
export global CalFmt {
    public pure function hhmm(min: int) -> string {
        return (Math.floor(min / 60) < 10 ? "0" : "") + Math.floor(min / 60) + ":" + (Math.mod(min, 60) < 10 ? "0" : "") + Math.mod(min, 60);
    }
    public pure function slot-color(state: int) -> color {
        return state == 2 ? #5b5fc7 : (state == 1 ? #5b5fc780 : (state == 3 ? #b146c2 : (state == 4 ? #5b5fc740 : (state == 5 ? #3a3a3a : #1c1c1c))));
    }
    public pure function slot-name(state: int) -> string {
        return state == 2 ? "busy" : (state == 1 ? "tentative" : (state == 3 ? "out of office" : (state == 4 ? "working elsewhere" : (state == 5 ? "unknown" : "free"))));
    }
    public pure function response-color(r: string) -> color {
        return r == "accepted" || r == "organizer" ? #6bd69b : (r == "declined" ? #ff8a8d : (r == "tentative" ? #ffd666 : #8a8a8a));
    }
    public pure function show-as-label(k: string) -> string {
        return k == "tentative" ? "Tentative" : (k == "free" ? "Free" : (k == "oof" ? "Out of office" : (k == "elsewhere" ? "Working elsewhere" : "Busy")));
    }
    public pure function response-text(r: string) -> string {
        return r == "accepted" ? "Accepted" : (r == "organizer" ? "Organizer" : (r == "declined" ? "Declined" : (r == "tentative" ? "Tentative" : "No response")));
    }
}
