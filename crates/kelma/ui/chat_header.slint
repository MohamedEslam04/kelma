// The chat header's "More chat options" (…) menu, as in Teams: Share screen, Mark as unread,
// Move to section, Mute, Copy link and Remove chat history, and the confirmation of the last one.
// Every item reuses what the chat list's item menu and the call buttons already send. When the
// header is narrow, its participants, find, details and Schedule a meeting buttons are items here
// (a channel's header then has this menu with those only).
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { ListStore } from "lists.slint";
import { DirectCallStore } from "call_incoming.slint";
import { PeopleStore } from "people.slint";
import { FindStore } from "find.slint";

export global ChatHeaderStore {
    // The chat whose "Remove chat history" waits for confirmation, or "".
    in-out property <string> remove-history;
}

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> keys;
    in property <bool> chevron: false;
    in property <bool> danger: false;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.keys;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.label; color: root.danger ? Theme.danger : Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: none; }
        if root.keys != "": Text { text: root.keys; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 0; accessible-role: none; }
        if root.chevron: Text { text: "›"; color: Theme.fg-muted; font-size: 15px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 0; accessible-role: none; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The menu itself (inside the button's popup).
export component HeaderMenu inherits Rectangle {
    in property <string> chat-id;
    in property <bool> muted;
    // A channel: only the header's own buttons (`extras`), none of the chat items.
    in property <bool> channel: false;
    // The header's buttons that did not fit.
    in property <bool> extras: false;
    callback mark-unread();
    callback schedule-meeting();
    callback done();
    // Share screen calls the other person, so only a 1:1 chat in a build with calls has it.
    property <bool> can-share: !root.channel && DirectCallStore.available && DirectCallStore.is-direct(root.chat-id);
    property <bool> can-people: !root.channel && (PeopleStore.header-group || PeopleStore.member-count > 0);
    property <int> extra-count: root.extras ? 2 + (root.can-people ? 1 : 0) + (root.channel ? 0 : 1) : 0;
    property <string> view: "main";
    out property <length> menu-height: (root.view == "main" ? root.extra-count + (root.channel ? 0 : 5) + (root.can-share ? 1 : 0) : ListStore.choices.length + 2) * 32px + 8px;
    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: @tr("More chat options");
    VerticalLayout {
        padding: 4px;
        if root.view == "main" && root.extras: VerticalLayout {
            if root.can-people: MenuItem {
                label: @tr("View and add participants");
                clicked => {
                    PeopleStore.participants-open = true;
                    PeopleStore.command("participants-open", "");
                    root.done();
                }
            }
            MenuItem {
                label: root.channel ? @tr("Find in channel") : @tr("Find in chat");
                clicked => {
                    FindStore.chat-find-open = true;
                    FindStore.chat-find-tick += 1;
                    FindStore.command("find-open", "");
                    root.done();
                }
            }
            MenuItem {
                label: @tr("Open chat details");
                clicked => {
                    FindStore.details-open = !FindStore.details-open;
                    FindStore.command("details", FindStore.details-open ? "open" : "close");
                    root.done();
                }
            }
            if !root.channel: MenuItem { label: @tr("Schedule a meeting"); clicked => { root.schedule-meeting(); root.done(); } }
        }
        if root.view == "main" && !root.channel: VerticalLayout {
            if root.can-share: MenuItem {
                label: @tr("Share screen");
                keys: "Ctrl+Shift+E";
                clicked => {
                    DirectCallStore.command("share-screen", root.chat-id);
                    root.done();
                }
            }
            MenuItem { label: @tr("Mark as unread"); clicked => { root.mark-unread(); root.done(); } }
            MenuItem { label: @tr("Move to section"); chevron: true; clicked => { root.view = "sections"; } }
            MenuItem {
                label: root.muted ? @tr("Unmute") : @tr("Mute");
                clicked => {
                    ListStore.command(root.muted ? "unmute" : "mute", root.chat-id);
                    root.done();
                }
            }
            MenuItem { label: @tr("Copy link"); clicked => { ListStore.command("copy-link", root.chat-id); root.done(); } }
            MenuItem {
                label: @tr("Remove chat history");
                danger: true;
                clicked => {
                    ChatHeaderStore.remove-history = root.chat-id;
                    root.done();
                }
            }
        }
        if root.view == "sections": VerticalLayout {
            MenuItem { label: @tr("‹ Move to section"); clicked => { root.view = "main"; } }
            for c in ListStore.choices: MenuItem {
                label: c.name;
                clicked => {
                    ListStore.command("move", root.chat-id + "\u{9}" + c.id);
                    root.done();
                }
            }
            MenuItem {
                label: @tr("New section");
                clicked => {
                    ListStore.dialog-target = root.chat-id;
                    ListStore.dialog-text = "";
                    ListStore.dialog = "new-section";
                    root.done();
                }
            }
        }
    }
}

// The "…" button of the header and its menu.
export component HeaderMoreButton inherits Rectangle {
    in property <string> chat-id;
    in property <bool> muted;
    in property <bool> channel: false;
    in property <bool> extras: false;
    callback mark-unread();
    callback schedule-meeting();
    width: 32px;
    height: 32px;
    more-btn := IconButton {
        icon: @image-url("icons/more.svg");
        tooltip: @tr("More chat options");
        clicked => { more-popup.show(); }
    }
    more-popup := PopupWindow {
        x: root.width - 240px;
        y: root.height + 4px;
        width: 240px;
        height: menu.menu-height;
        close-policy: close-on-click-outside;
        menu := HeaderMenu {
            chat-id: root.chat-id;
            muted: root.muted;
            channel: root.channel;
            extras: root.extras;
            mark-unread => { root.mark-unread(); }
            schedule-meeting => { root.schedule-meeting(); }
            done => { more-popup.close(); }
        }
    }
}

// "Remove chat history?" before the history goes.
export component RemoveHistoryConfirm inherits Rectangle {
    callback confirm();
    callback cancel();
    width: 400px;
    height: 160px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;
    accessible-role: groupbox;
    accessible-label: @tr("Remove chat history?");
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: @tr("Remove chat history?"); color: Theme.fg; font-size: 17px * Theme.font-scale; font-weight: 700; }
        Text { text: @tr("The messages so far will be removed for you only. The other people in the chat keep them."); color: Theme.fg-muted; font-size: 13px * Theme.font-scale; wrap: word-wrap; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            height: 32px;
            cancel-btn := Rectangle {
                width: 80px;
                border-radius: 4px;
                background: cancel-touch.has-hover ? Theme.surface-hover.brighter(0.2) : Theme.surface-hover;
                accessible-role: button;
                accessible-label: @tr("Cancel");
                accessible-action-default => { root.cancel(); }
                Text { text: @tr("Cancel"); color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
            }
            remove-btn := Rectangle {
                width: 90px;
                border-radius: 4px;
                background: remove-touch.has-hover ? #e04a4f : Theme.danger;
                accessible-role: button;
                accessible-label: @tr("Remove");
                accessible-action-default => { root.confirm(); }
                Text { text: @tr("Remove"); color: #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.confirm(); } }
            }
        }
    }
}
