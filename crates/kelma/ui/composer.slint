import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";

export component Composer inherits Rectangle {
    in property <bool> current-is-channel;
    in property <string> thread-root;
    in property <string> reply-author;
    in property <string> reply-preview;
    in property <string> editing-id;
    in-out property <string> draft;
    in-out property <string> post-subject;
    in-out property <int> focus-tick;
    // true: Enter sends and Shift+Enter adds a line. false: Enter adds a line and Ctrl+Enter sends.
    in-out property <bool> enter-sends: true;

    callback send(string);
    callback set-enter-sends(bool);
    callback typing-tick();
    callback cancel-reply();
    callback attach-image();
    callback attach-file();

    function submit() {
        if composer-input.text != "" {
            root.send(composer-input.text);
            composer-input.text = "";
        }
    }

    // Size like the layout inside, so the parent layout treats this exactly as it did the bare layout.
    min-width: body.min-width;
    preferred-width: body.preferred-width;
    max-width: body.max-width;
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    max-height: body.max-height;

    body := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 16px;
        padding-top: 6px;
        Rectangle {
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: #3a3a3a;
            VerticalLayout {
                if root.reply-preview != "": Rectangle {
                    background: #1f1f1f;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle { width: 3px; background: Theme.accent; }
                        VerticalLayout {
                            Text { text: root.editing-id != "" ? "Editing message" : "Replying to " + root.reply-author; color: Theme.fg-muted; font-size: 11px; font-weight: 600; }
                            Text { text: root.reply-preview; color: Theme.fg-muted; font-size: 12px; overflow: elide; }
                        }
                        IconButton { icon: @image-url("icons/close.svg"); size: 24px; clicked => { root.cancel-reply(); } }
                    }
                }
                if root.current-is-channel && root.thread-root == "": HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    height: 34px;
                    TextInput {
                        text <=> root.post-subject;
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                        single-line: true;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: max(44px, min(220px, composer-input.preferred-height + 20px));
                    composer-scope := FocusScope {
                        capture-key-pressed(event) => {
                            if (event.text == Key.Return && (root.enter-sends ? !event.modifiers.shift : event.modifiers.control || event.modifiers.meta)) {
                                root.submit();
                                return accept;
                            }
                            reject
                        }
                        composer-input := TextInput {
                            property <int> tick: root.focus-tick;
                            changed tick => { self.focus(); }
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            text <=> root.draft;
                            color: Theme.fg;
                            font-size: 14px;
                            single-line: false;
                            wrap: word-wrap;
                            edited => { root.typing-tick(); }
                        }
                    }
                    if composer-input.text == "": Text {
                        x: 14px;
                        y: 10px;
                        text: root.current-is-channel && root.thread-root == "" ? "Start a post" : "Type a message";
                        color: Theme.fg-subtle;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    alignment: end;
                    IconButton { icon: @image-url("icons/emoji.svg"); clicked => { emoji-popup.show(); } }
                    IconButton { icon: @image-url("icons/image.svg"); clicked => { root.attach-image(); } }
                    IconButton { icon: @image-url("icons/attach.svg"); clicked => { root.attach-file(); } }
                    IconButton { icon: @image-url("icons/more.svg"); clicked => { more-popup.show(); } }
                    Rectangle { width: 1px; background: Theme.border; }
                    IconButton {
                        icon: @image-url("icons/send.svg");
                        tint: composer-input.text != "" ? Theme.accent : Theme.fg-subtle;
                        clicked => { root.submit(); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: composer-input.has-focus ? Theme.accent : transparent;
            }
        }
    }

    emoji-popup := PopupWindow {
        x: parent.width - 380px;
        y: parent.height - 300px;
        width: 320px;
        height: 220px;
        Rectangle {
            background: #2b2b2b;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 8px;
                for row in [["😀", "😂", "😊", "😍", "😎", "🤔", "😅", "😢"], ["😡", "👍", "👎", "👏", "🙏", "💪", "🎉", "🔥"], ["❤️", "💯", "✅", "❌", "👀", "🚀", "⭐", "☕"], ["😴", "🤝", "🙌", "😬", "🤯", "😇", "🥳", "💡"]]: HorizontalLayout {
                    for e in row: Rectangle {
                        width: 36px;
                        height: 44px;
                        border-radius: 4px;
                        background: ea.has-hover ? Theme.surface-hover : transparent;
                        Text { text: e; font-size: 20px; }
                        ea := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.draft = root.draft + e;
                                root.focus-tick += 1;
                            }
                        }
                    }
                }
            }
        }
    }

    more-popup := PopupWindow {
        x: parent.width - 330px;
        y: parent.height - 190px;
        width: 260px;
        height: 110px;
        Rectangle {
            background: #2b2b2b;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text { text: "When writing a message, press Enter to"; color: Theme.fg-muted; font-size: 11px; wrap: word-wrap; }
                for opt[i] in ["Send the message", "Start a new line"]: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: enter-opt.has-hover ? Theme.surface-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Text { text: (i == 0) == root.enter-sends ? "●" : "○"; color: Theme.accent; vertical-alignment: center; }
                        Text { text: opt; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                    }
                    enter-opt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.enter-sends = i == 0;
                            root.set-enter-sends(i == 0);
                        }
                    }
                }
            }
        }
    }
}
