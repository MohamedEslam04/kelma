// The composer's GIF picker: a search box (trending when empty) and a grid of previews from
// Teams' Giphy extension. Rust fills `GifStore`; picking sends the GIF to the open chat.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct GifItem { title: string, preview: image, has-preview: bool }

export global GifStore {
    in property <[GifItem]> items;
    in property <string> status;
    callback command(string, string);
}

export component GifPicker inherits Rectangle {
    callback picked();
    in-out property <string> query;
    property <length> cell: (self.width - 20px - 2 * 6px) / 3;
    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: @tr("GIFs");
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: gif-search.has-focus ? Theme.accent : Theme.border;
            gif-search := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.query;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: @tr("Search GIFs");
                accepted => { GifStore.command("search", self.text); }
            }
            if root.query == "": Text { x: 10px; height: parent.height; vertical-alignment: center; text: @tr("Search GIFs (Enter)"); color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
        }
        if GifStore.status != "": Text { text: GifStore.status; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
        ScrollView {
            vertical-stretch: 1;
            viewport-height: ceil(GifStore.items.length / 3) * (root.cell + 6px);
            for g[i] in GifStore.items: Rectangle {
                x: mod(i, 3) * (root.cell + 6px);
                y: floor(i / 3) * (root.cell + 6px);
                width: root.cell;
                height: root.cell;
                border-radius: 4px;
                clip: true;
                background: gif-touch.has-hover ? Theme.surface-hover : Theme.sidebar;
                accessible-role: button;
                accessible-label: g.title;
                accessible-action-default => {
                    GifStore.command("pick", i);
                    root.picked();
                }
                if g.has-preview: Image { width: parent.width; height: parent.height; source: g.preview; image-fit: cover; }
                if !g.has-preview: Text { width: parent.width - 8px; x: 4px; height: parent.height; text: g.title; color: Theme.fg-subtle; font-size: 10px * Theme.font-scale; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                gif-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        GifStore.command("pick", i);
                        root.picked();
                    }
                }
            }
        }
        Text { text: @tr("Powered by GIPHY"); color: Theme.fg-subtle; font-size: 10px * Theme.font-scale; horizontal-alignment: right; }
    }
}
