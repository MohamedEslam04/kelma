// The message "…" menu (also opened by right click), like Teams.
import { Theme } from "theme.slint";
import { Icon } from "widgets.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> danger: false;
    in property <bool> indent: false;
    in property <bool> chevron: false;
    callback clicked();
    height: 34px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: root.indent ? 34px : 10px;
        padding-right: 10px;
        spacing: 10px;
        if !root.indent: Icon {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: 9px;
            tint: root.danger ? Theme.danger : Theme.fg-muted;
        }
        Text {
            text: root.label;
            color: root.danger ? Theme.danger : Theme.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.chevron: Icon {
            source: @image-url("icons/chevron-right.svg");
            width: 14px;
            height: 14px;
            y: 10px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MessageMenu inherits Rectangle {
    in property <bool> mine;
    in property <bool> saved;
    // Pinning for everyone is a chat feature; channel posts use another endpoint.
    in property <bool> can-pin: true;
    // A channel post can be followed (replies to it show in Followed threads).
    in property <bool> can-follow: false;
    in property <bool> following: false;
    // Translation state of the message (`Msg.translate`).
    in property <string> translate: "";
    callback toggle-follow();
    callback translate-message();
    callback see-original();
    callback reply();
    callback forward-one();
    callback forward-many();
    callback copy-link();
    callback toggle-save();
    callback pin();
    callback mark-unread();
    callback follow();
    callback edit();
    callback delete();

    // Whether the Forward entry shows its two choices.
    property <bool> forward-open: false;

    width: 240px;
    height: items.preferred-height + 12px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000090;

    // Teams' letter shortcuts: R reply, F forward, S save, P pin, U mark as unread.
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if event.text == "r" || event.text == "R" { root.reply(); return accept; }
            if event.text == "f" || event.text == "F" { root.forward-one(); return accept; }
            if (event.text == "s" || event.text == "S") && !root.mine { root.toggle-save(); return accept; }
            if (event.text == "p" || event.text == "P") && root.can-pin { root.pin(); return accept; }
            if event.text == "u" || event.text == "U" { root.mark-unread(); return accept; }
            reject
        }
    }

    items := VerticalLayout {
        padding: 6px;
        spacing: 0px;
        MenuItem { label: @tr("Reply with quote"); icon: @image-url("icons/quote.svg"); clicked => { root.reply(); } }
        MenuItem { label: @tr("Forward"); icon: @image-url("icons/forward.svg"); chevron: true; clicked => { root.forward-open = !root.forward-open; } }
        if root.forward-open: MenuItem { label: @tr("This message"); indent: true; clicked => { root.forward-one(); } }
        if root.forward-open: MenuItem { label: @tr("Multiple messages"); indent: true; clicked => { root.forward-many(); } }
        MenuItem { label: @tr("Copy message link"); icon: @image-url("icons/link.svg"); clicked => { root.copy-link(); } }
        if !root.mine: MenuItem {
            label: root.saved ? @tr("Unsave this message") : @tr("Save this message");
            icon: @image-url("icons/star.svg");
            clicked => { root.toggle-save(); }
        }
        if root.can-pin: MenuItem { label: @tr("Pin for everyone"); icon: @image-url("icons/pin.svg"); clicked => { root.pin(); } }
        if root.can-follow: MenuItem {
            label: root.following ? @tr("Unfollow thread") : @tr("Follow thread");
            icon: @image-url("icons/thread.svg");
            clicked => { root.toggle-follow(); }
        }
        if root.translate == "shown": MenuItem { label: @tr("See original"); icon: @image-url("icons/translate.svg"); clicked => { root.see-original(); } }
        if root.translate != "" && root.translate != "shown" && root.translate != "busy": MenuItem { label: @tr("Translate"); icon: @image-url("icons/translate.svg"); clicked => { root.translate-message(); } }
        MenuItem { label: @tr("Mark as unread"); icon: @image-url("icons/unread.svg"); clicked => { root.mark-unread(); } }
        if root.mine: MenuItem { label: @tr("Edit"); icon: @image-url("icons/edit.svg"); clicked => { root.edit(); } }
        if root.mine: MenuItem { label: @tr("Delete"); icon: @image-url("icons/trash.svg"); danger: true; clicked => { root.delete(); } }
    }
}
