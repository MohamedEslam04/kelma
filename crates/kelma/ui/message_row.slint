import { Theme } from "theme.slint";
import { Msg } from "types.slint";
import { Avatar, FileCard, Icon, IconButton, LoopCardView, ReactionChip } from "widgets.slint";
import { CardView } from "card_view.slint";
import { LinkCardView, MediaStore } from "media.slint";

// Right clicks the window saw (`main.rs` counts them). The words of a message are selectable
// text, which takes the press, as do its links and buttons, so the row's own `pointer-event`
// never sees a right click on them: the hovered row opens its menu from this count instead.
export global MessagePointer {
    in-out property <int> right-clicks;
}

export component MessageRow inherits TouchArea {
    in property <Msg> m;
    in property <length> max-bubble: 600px;
    in property <bool> in-channel: false;
    // Inside a channel post card: everyone is drawn on the left with an avatar and a name.
    in property <bool> card-style: false;
    // Multi-select mode: a checkbox per row, clicking toggles it, no hover bar.
    in property <bool> select-mode: false;
    callback react(string);
    callback reply();
    callback edit();
    // "More reactions" and the "…" menu, anchored at window coordinates.
    callback more-reactions(length, length);
    callback menu(length, length);
    callback toggle-select();
    callback open-url(string);
    callback open-thread();
    callback retry-send();
    callback discard-send();
    // Click on the avatar or the sender's name: open the profile card (sender MRI).
    callback profile(string);
    // The pointer rested on the photo or name (opens the card as a hover card).
    callback profile-hover(string);
    height: content.preferred-height;

    // Right click opens the same menu as the "…" button, where the pointer is.
    function open-menu-here() {
        if !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed && !root.select-mode {
            root.menu(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
            root.open-menu-here();
        }
    }
    property <int> right-clicks: MessagePointer.right-clicks;
    changed right-clicks => {
        if root.has-hover { root.open-menu-here(); }
    }

    if root.m.selected: Rectangle { background: #7f85f526; }
    // The row a jump from the pinned banner landed on.
    if root.m.flash: Rectangle { background: #7f85f540; }

    content := VerticalLayout {
        width: root.width;
        padding-left: root.select-mode ? 44px : 20px;
        padding-right: 20px;
        padding-top: root.m.show-header || root.m.day != "" ? 10px : 2px;
        spacing: 4px;

        if root.m.day != "": HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
            Text { text: root.m.day; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
        }

        if root.m.new-above: HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
            Text { text: @tr("New messages"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
        }

        if root.m.system: Text {
            text: root.m.plain;
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            font-italic: true;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if !root.m.system: HorizontalLayout {
            alignment: root.m.mine && !root.card-style ? end : start;
            spacing: 10px;

            if !root.m.mine || root.card-style: Rectangle {
                width: 32px;
                if root.m.show-header: Avatar {
                    y: 0;
                    initials: root.m.initials;
                    tone: root.m.color;
                    img: root.m.avatar;
                    has-img: root.m.has-avatar;
                    size: 32px;
                    avatar-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: @tr("Open profile of {}", root.m.sender);
                        accessible-action-default => { root.profile(root.m.sender-id); }
                        clicked => { root.profile(root.m.sender-id); }
                    }
                    // Resting on the photo opens the card, as in Teams.
                    Timer {
                        interval: 600ms;
                        running: avatar-touch.has-hover;
                        triggered => { root.profile-hover(root.m.sender-id); }
                    }
                }
            }

            bubble := Rectangle {
                max-width: root.max-bubble;
                border-radius: Theme.radius;
                background: root.m.mentions-me ? #3a3a63 : (root.m.mine ? Theme.bubble-mine : Theme.bubble-other);
                opacity: root.m.pending ? 0.6 : 1.0;
                border-width: root.m.failed || root.m.mentions-me ? 1px : 0px;
                border-color: root.m.failed ? Theme.danger : Theme.accent;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    if root.m.show-header || root.m.mine: HorizontalLayout {
                        spacing: 8px;
                        alignment: root.m.mine && !root.card-style ? end : start;
                        if !root.m.mine || root.card-style: Rectangle {
                            width: min(sender-text.preferred-width, max(80px, root.max-bubble - 160px));
                            sender-text := Text { width: parent.width; text: root.m.sender; color: Theme.fg; font-size: 12px * Theme.font-scale; font-weight: 600; overflow: elide; }
                            sender-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("Open profile of {}", root.m.sender);
                                accessible-action-default => { root.profile(root.m.sender-id); }
                                clicked => { root.profile(root.m.sender-id); }
                            }
                            Timer {
                                interval: 600ms;
                                running: sender-touch.has-hover;
                                triggered => { root.profile-hover(root.m.sender-id); }
                            }
                        }
                        Text { text: root.m.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                        if root.m.edited: Text { text: @tr("Edited"); color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                    }

                    if root.m.importance != "": Text {
                        text: root.m.importance == "urgent" ? @tr("URGENT!") : @tr("IMPORTANT!");
                        color: Theme.danger;
                        font-size: 12px;
                        font-weight: 800;
                        accessible-role: text;
                    }

                    if root.m.subject != "": Text {
                        text: root.m.subject;
                        color: Theme.fg;
                        font-size: 15px * Theme.font-scale;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.m.quote-text != "": Rectangle {
                        background: Theme.sidebar;
                        border-radius: 4px;
                        HorizontalLayout {
                            Rectangle { width: 3px; background: Theme.accent; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text { text: root.m.quote-author; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; font-weight: 600; overflow: elide; }
                                Text { text: root.m.quote-text; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; max-height: 48px; overflow: elide; }
                            }
                        }
                    }

                    if root.m.deleted: Text { text: @tr("This message has been deleted."); color: Theme.fg-subtle; font-italic: true; font-size: 13px * Theme.font-scale; }

                    if !root.m.deleted && root.m.card.length > 0: CardView {
                        rows: root.m.card;
                        min-width: min(420px, root.max-bubble - 28px);
                        open-url(u) => { root.open-url(u); }
                    }

                    if !root.m.deleted && root.m.plain != "" && (root.m.card.length == 0 || root.m.headline != ""): StyledText {
                        text: root.m.body;
                        default-color: Theme.fg;
                        default-font-size: 14px * Theme.font-scale;
                        link-color: Theme.accent;
                        selectable: true;
                        horizontal-alignment: root.m.rtl ? right : left;
                        link-clicked(url) => { root.open-url(url); }
                    }

                    // Several pictures form a grid (plan 9.5); clicking one opens the viewer.
                    if root.m.images.length > 0: Rectangle {
                        width: root.m.grid-w;
                        height: root.m.grid-h;
                        for im[i] in root.m.images: Rectangle {
                            x: im.x;
                            y: im.y;
                            width: im.w;
                            height: im.h;
                            border-radius: 4px;
                            background: Theme.sidebar;
                            clip: true;
                            if im.loaded: Image { source: im.img; width: parent.width; height: parent.height; image-fit: cover; }
                            if !im.loaded: Text { text: @tr("Loading image…"); color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                            if im.overflow > 0: Rectangle {
                                background: #000000a0;
                                Text { text: "+" + im.overflow; color: #ffffff; font-size: 22px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("Open image {}", i + 1);
                                accessible-action-default => { MediaStore.command("image", root.m.id + "|" + im.url); }
                                clicked => { MediaStore.command("image", root.m.id + "|" + im.url); }
                            }
                        }
                    }

                    // Translate (plan 9.6): a link under a message in another language, "See original" after.
                    if root.m.translate == "offer" || root.m.translate == "busy" || root.m.translate == "shown" || root.m.translate == "failed": HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        height: 18px;
                        if root.m.translate == "busy": Text { text: @tr("Translating…"); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate == "shown": Text { text: @tr("Translated from {}", root.m.translate-from); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate == "failed": Text { text: @tr("Could not translate"); color: Theme.danger; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate != "busy" && root.m.translate != "shown": Rectangle {
                            width: tr-link.preferred-width;
                            tr-link := Text { text: root.m.translate == "failed" ? @tr("Retry") : @tr("Translate"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: root.m.translate == "failed" ? @tr("Retry translation") : @tr("Translate message");
                                accessible-action-default => { MediaStore.command("translate", root.m.id); }
                                clicked => { MediaStore.command("translate", root.m.id); }
                            }
                        }
                        if root.m.translate == "shown": Rectangle {
                            width: orig-link.preferred-width;
                            orig-link := Text { text: @tr("See original"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("See original");
                                accessible-action-default => { MediaStore.command("original", root.m.id); }
                                clicked => { MediaStore.command("original", root.m.id); }
                            }
                        }
                    }

                    // Link preview cards (plan 9.7).
                    for c in root.m.links: LinkCardView {
                        c: c;
                        min-width: min(420px, root.max-bubble - 28px);
                        open(u) => { root.open-url(u); }
                    }

                    // Loop components are cards, not bare links.
                    for l in root.m.loops: LoopCardView {
                        title: l.title;
                        url: l.url;
                        min-width: min(320px, root.max-bubble - 28px);
                        open(u) => { root.open-url(u); }
                    }

                    for f in root.m.files: FileCard {
                        f: f;
                        min-width: 280px;
                        open => { root.open-url("kelma-file:" + f.ext + ":" + f.url); }
                        action(a) => { MediaStore.command("file", a + "\u{1f}" + f.url); }
                    }

                    if root.m.reactions.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for r in root.m.reactions: ReactionChip {
                            r: r;
                            clicked => { root.react(r.key); }
                        }
                    }

                    if root.m.failed: HorizontalLayout {
                        spacing: 6px;
                        alignment: root.m.mine ? end : start;
                        Text { text: @tr("Failed to send"); color: Theme.danger; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Rectangle {
                            width: retry-text.preferred-width;
                            retry-text := Text { text: @tr("Retry"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.retry-send(); } }
                        }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Rectangle {
                            width: discard-text.preferred-width;
                            discard-text := Text { text: @tr("Delete"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.discard-send(); } }
                        }
                    }

                    if root.in-channel && root.m.reply-count >= 0: Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            Icon { source: @image-url("icons/thread.svg"); width: 14px; height: 14px; tint: Theme.accent; y: 4px; }
                            Text {
                                text: root.m.reply-count == 0 ? @tr("Reply") : (root.m.reply-count == 1 ? @tr("1 reply") : @tr("{} replies", root.m.reply-count));
                                color: Theme.accent;
                                font-size: 12px * Theme.font-scale;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(); } }
                    }
                }

                if root.has-hover && !root.select-mode && !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed: bar := Rectangle {
                    // At the top right corner of the bubble, as in Teams: its right edge just inside
                    // the bubble's. A bar wider than someone else's (left) bubble starts at the
                    // bubble, so it never covers the sender's avatar (the profile card); mine
                    // extends to the left. It keeps to the top band of the row.
                    x: root.m.mine && !root.card-style ? parent.width - self.width - 8px : max(0px, parent.width - self.width - 8px);
                    y: root.absolute-position.y - parent.absolute-position.y;
                    height: 32px;
                    width: actions.preferred-width;
                    border-radius: 4px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #00000080;
                    actions := HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 0px;
                        // Teams' quick reactions, then the rest of the buttons.
                        for e in [{k: "like", t: "👍"}, {k: "heart", t: "❤️"}, {k: "laugh", t: "😆"}, {k: "surprised", t: "😮"}]: Rectangle {
                            width: 30px;
                            background: et.has-hover ? Theme.surface-hover : transparent;
                            border-radius: 4px;
                            Text { text: e.t; font-size: 16px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                            et := TouchArea { mouse-cursor: pointer; clicked => { root.react(e.k); } }
                        }
                        IconButton {
                            icon: @image-url("icons/emoji.svg"); tooltip: @tr("More reactions");
                            size: 30px;
                            clicked => { root.more-reactions(bar.absolute-position.x + bar.width - 308px, bar.absolute-position.y + bar.height + 4px); }
                        }
                        Rectangle { width: 1px; background: Theme.border; }
                        IconButton { icon: @image-url("icons/quote.svg"); tooltip: @tr("Reply with quote"); size: 30px; clicked => { root.reply(); } }
                        if root.m.mine: IconButton { icon: @image-url("icons/edit.svg"); tooltip: @tr("Edit"); size: 30px; clicked => { root.edit(); } }
                        IconButton {
                            icon: @image-url("icons/more.svg"); tooltip: @tr("More actions");
                            size: 30px;
                            clicked => { root.menu(bar.absolute-position.x + bar.width - 240px, bar.absolute-position.y + bar.height + 4px); }
                        }
                    }
                }
            }
        }

        // Read receipt under my newest message: a check once sent, an eye when someone saw it.
        if root.m.receipt != "": receipt-mark := HorizontalLayout {
            alignment: end;
            spacing: 4px;
            height: 16px;
            accessible-role: text;
            accessible-label: root.m.receipt == "seen" ? (root.m.receipt-names != "" ? @tr("Seen by {}", root.m.receipt-names) : @tr("Seen")) : @tr("Sent");
            Icon {
                source: root.m.receipt == "seen" ? @image-url("icons/eye.svg") : @image-url("icons/check.svg");
                tint: root.m.receipt == "seen" ? Theme.accent : Theme.fg-subtle;
                width: 12px;
                height: 12px;
                y: 2px;
            }
            if root.m.receipt == "seen": Text {
                text: root.m.receipt-names != "" ? @tr("Seen by {}", root.m.receipt-names) : @tr("Seen");
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
    }

    if root.select-mode && !root.m.system && !root.m.deleted: Rectangle {
        x: 12px;
        y: 12px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.m.selected ? Theme.accent : Theme.fg-subtle;
        background: root.m.selected ? Theme.accent-strong : transparent;
        accessible-role: checkbox;
        accessible-label: @tr("Select message");
        accessible-checkable: true;
        accessible-checked: root.m.selected;
        Text { text: root.m.selected ? "✓" : ""; color: #ffffff; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.select-mode && !root.m.system && !root.m.deleted: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-select(); }
    }
}
