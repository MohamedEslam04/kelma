import { Theme } from "theme.slint";
import { Msg } from "types.slint";
import { Avatar, FileCard, Icon, IconButton, ReactionChip } from "widgets.slint";

export component MessageRow inherits TouchArea {
    in property <Msg> m;
    in property <length> max-bubble: 600px;
    in property <bool> in-channel: false;
    callback react(string);
    callback reply();
    callback edit();
    callback delete();
    callback open-url(string);
    callback open-thread();
    callback open-image(string);
    callback retry-send();
    callback discard-send();
    height: content.preferred-height;

    content := VerticalLayout {
        width: root.width;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: root.m.show-header || root.m.day != "" ? 10px : 2px;
        spacing: 4px;

        if root.m.day != "": HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
            Text { text: root.m.day; color: Theme.fg-muted; font-size: 12px; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
        }

        if root.m.new-above: HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
            Text { text: "New messages"; color: Theme.accent; font-size: 12px; font-weight: 600; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
        }

        if root.m.system: Text {
            text: root.m.plain;
            color: Theme.fg-subtle;
            font-size: 12px;
            font-italic: true;
            horizontal-alignment: center;
        }

        if !root.m.system: HorizontalLayout {
            alignment: root.m.mine ? end : start;
            spacing: 10px;

            if !root.m.mine: Rectangle {
                width: 32px;
                if root.m.show-header: Avatar {
                    y: 0;
                    initials: root.m.initials;
                    tone: root.m.color;
                    img: root.m.avatar;
                    has-img: root.m.has-avatar;
                    size: 32px;
                }
            }

            bubble := Rectangle {
                max-width: root.max-bubble;
                border-radius: Theme.radius;
                background: root.m.mine ? Theme.bubble-mine : Theme.bubble-other;
                opacity: root.m.pending ? 0.6 : 1.0;
                border-width: root.m.failed ? 1px : 0px;
                border-color: Theme.danger;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    if root.m.show-header || root.m.mine: HorizontalLayout {
                        spacing: 8px;
                        alignment: root.m.mine ? end : start;
                        if !root.m.mine: Text { text: root.m.sender; color: Theme.fg; font-size: 12px; font-weight: 600; }
                        Text { text: root.m.time; color: Theme.fg-subtle; font-size: 11px; }
                        if root.m.edited: Text { text: "Edited"; color: Theme.fg-subtle; font-size: 11px; }
                    }

                    if root.m.subject != "": Text {
                        text: root.m.subject;
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.m.quote-text != "": Rectangle {
                        background: #1f1f1f;
                        border-radius: 4px;
                        HorizontalLayout {
                            Rectangle { width: 3px; background: Theme.accent; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text { text: root.m.quote-author; color: Theme.fg-muted; font-size: 11px; font-weight: 600; }
                                Text { text: root.m.quote-text; color: Theme.fg-muted; font-size: 12px; wrap: word-wrap; max-height: 48px; overflow: elide; }
                            }
                        }
                    }

                    if root.m.deleted: Text { text: "This message has been deleted."; color: Theme.fg-subtle; font-italic: true; font-size: 13px; }

                    if !root.m.deleted && root.m.plain != "": StyledText {
                        text: root.m.body;
                        default-color: Theme.fg;
                        default-font-size: 14px;
                        link-color: Theme.accent;
                        selectable: true;
                        horizontal-alignment: root.m.rtl ? right : left;
                        link-clicked(url) => { root.open-url(url); }
                    }

                    for im in root.m.images: Rectangle {
                        width: im.w;
                        height: im.h;
                        border-radius: 4px;
                        background: #1f1f1f;
                        clip: true;
                        if im.loaded: Image { source: im.img; width: parent.width; height: parent.height; image-fit: contain; }
                        if !im.loaded: Text { text: "Loading image…"; color: Theme.fg-subtle; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-image(im.url); } }
                    }

                    for f in root.m.files: FileCard {
                        f: f;
                        min-width: 280px;
                        open => { root.open-url(f.url); }
                    }

                    if root.m.reactions.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for r in root.m.reactions: ReactionChip {
                            r: r;
                            clicked => { root.react(r.key); }
                        }
                    }

                    if root.m.failed: HorizontalLayout {
                        spacing: 6px;
                        alignment: root.m.mine ? end : start;
                        Text { text: "Failed to send"; color: Theme.danger; font-size: 12px; vertical-alignment: center; }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px; vertical-alignment: center; }
                        Rectangle {
                            width: retry-text.preferred-width;
                            retry-text := Text { text: "Retry"; color: Theme.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.retry-send(); } }
                        }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px; vertical-alignment: center; }
                        Rectangle {
                            width: discard-text.preferred-width;
                            discard-text := Text { text: "Delete"; color: Theme.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.discard-send(); } }
                        }
                    }

                    if root.in-channel && root.m.reply-count >= 0: Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            Icon { source: @image-url("icons/thread.svg"); width: 14px; height: 14px; tint: Theme.accent; y: 4px; }
                            Text {
                                text: root.m.reply-count == 0 ? "Reply" : (root.m.reply-count == 1 ? "1 reply" : root.m.reply-count + " replies");
                                color: Theme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(); } }
                    }
                }
            }
        }
    }

    if root.has-hover && !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed: Rectangle {
        x: root.m.mine ? parent.width - self.width - 28px : 70px;
        y: 0px;
        height: 32px;
        width: actions.preferred-width;
        border-radius: 4px;
        background: #2b2b2b;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000080;
        actions := HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 0px;
            for e in [{k: "like", t: "👍"}, {k: "heart", t: "❤️"}, {k: "laugh", t: "😆"}, {k: "surprised", t: "😮"}, {k: "sad", t: "😢"}, {k: "angry", t: "😡"}]: Rectangle {
                width: 30px;
                background: et.has-hover ? Theme.surface-hover : transparent;
                border-radius: 4px;
                Text { text: e.t; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                et := TouchArea { mouse-cursor: pointer; clicked => { root.react(e.k); } }
            }
            Rectangle { width: 1px; background: Theme.border; }
            IconButton { icon: @image-url("icons/reply.svg"); size: 30px; clicked => { root.reply(); } }
            if root.m.mine: IconButton { icon: @image-url("icons/edit.svg"); size: 30px; clicked => { root.edit(); } }
            if root.m.mine: IconButton { icon: @image-url("icons/trash.svg"); size: 30px; clicked => { root.delete(); } }
        }
    }
}
