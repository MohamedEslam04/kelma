// State and commands shared by the people-and-conversations pieces (plan 6.1 to 6.7): the @mention
// picker, the New chat pane, the participants popover, the profile card, the pinned messages
// banner and read receipts. Rust fills the properties; the UI sends `command(name, argument)`.
import { PersonItem, PinnedItem } from "types.slint";

export global PeopleStore {
    // @mention picker: candidates for the `@query` before the composer cursor.
    in property <[PersonItem]> mention-items;

    // New chat pane (Alt+Shift+N): who is addressed, the search suggestions and a hint such as
    // "A chat with these people already exists".
    in-out property <bool> new-chat-open: false;
    in property <[PersonItem]> new-chat-to;
    in property <[PersonItem]> new-chat-results;
    in property <string> new-chat-hint;

    // Group chat header: the pencil (rename) and the participants button.
    in property <bool> header-group: false;
    in property <int> member-count: 0;
    in-out property <bool> participants-open: false;
    in property <[PersonItem]> members;
    in property <[PersonItem]> add-results;
    // Chat id waiting for a "Leave this chat?" confirmation; empty when none.
    in-out property <string> leave-confirm;

    // Profile card.
    in-out property <bool> card-open: false;
    in property <bool> card-loading: false;
    in property <PersonItem> card;
    in property <string> card-email;
    in property <string> card-work;
    in property <string> card-location;
    in property <string> card-time;
    in property <string> card-presence;
    in property <string> card-presence-label;
    in property <string> card-work-location;
    // The card was opened by hovering (it closes when the pointer leaves it and its photo).
    in-out property <bool> card-by-hover: false;
    // The photo (or name) the card belongs to, in window coordinates: the card opens next to
    // it. A width of 0 means none (the card opens in the middle of the window).
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-w;
    in-out property <length> anchor-h;
    // The photo under the pointer, and where it is. `hover-armed` is cleared once its card has
    // been opened, so resting on it does not open the card again and again.
    in-out property <string> hover-id;
    in-out property <bool> hover-armed;
    in-out property <length> hover-x;
    in-out property <length> hover-y;
    in-out property <length> hover-w;
    in-out property <length> hover-h;

    // Opens the profile card of `id` next to the rectangle (window coordinates); `hover` opens
    // it as a hover card.
    public function open-card(id: string, x: length, y: length, w: length, h: length, hover: bool) {
        if id == "" { return; }
        root.anchor-x = x;
        root.anchor-y = y;
        root.anchor-w = w;
        root.anchor-h = h;
        root.card-by-hover = hover;
        root.command("profile", id);
    }
    // The pointer came onto a person's photo: their card opens after a short rest (the window's
    // timer, so a list row that is rebuilt meanwhile does not lose it).
    public function hover-enter(id: string, x: length, y: length, w: length, h: length) {
        if id == "" { return; }
        root.hover-id = id;
        root.hover-x = x;
        root.hover-y = y;
        root.hover-w = w;
        root.hover-h = h;
        root.hover-armed = true;
    }
    public function hover-leave(id: string) {
        if root.hover-id == id {
            root.hover-id = "";
            root.hover-armed = false;
        }
    }

    // Pinned messages banner: the pins of the open chat and the one shown.
    in property <[PinnedItem]> pinned;
    in-out property <int> pinned-index: 0;

    // Read receipts on (shown on your newest message).
    in property <bool> receipts-on: true;

    // (name, argument). Names: mention-query, mention-pick, new-chat-open, new-chat-close,
    // new-chat-query, new-chat-add, new-chat-remove, new-chat-name, new-chat-send, rename,
    // participants-open, add-query, add-pick, add-history, leave, profile, profile-copy-email,
    // profile-chat, pin-jump, pin-unpin, receipts.
    callback command(string, string);
}
