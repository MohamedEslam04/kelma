// Multi-select mode footer: how many messages are ticked, Forward and Cancel.
import { Theme } from "theme.slint";

export component SelectBar inherits Rectangle {
    in property <int> count;
    in property <int> max: 5;
    callback forward();
    callback cancel();

    height: 48px;
    background: Theme.sidebar;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;
        Text {
            text: root.count + " of " + root.max + " selected";
            color: Theme.fg;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 80px;
            height: 32px;
            y: 8px;
            border-radius: 4px;
            background: cancel-touch.has-hover ? Theme.surface-hover : transparent;
            Text { text: "Cancel"; color: Theme.fg; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
        }
        Rectangle {
            width: 90px;
            height: 32px;
            y: 8px;
            border-radius: 4px;
            background: Theme.accent-strong;
            opacity: root.count > 0 ? 1.0 : 0.5;
            accessible-role: button;
            accessible-label: "Forward selected";
            Text { text: "Forward"; color: #ffffff; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            forward-touch := TouchArea {
                enabled: root.count > 0;
                mouse-cursor: pointer;
                clicked => { root.forward(); }
            }
        }
    }
}
