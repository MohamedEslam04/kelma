// The Settings page (plans/settings-and-platform.md X1.1): a list of pages on the left with
// "Find in Settings" (Ctrl+Alt+F) on top and About at the bottom, the open page on the right.
// It covers the area right of the rail; Esc or the back arrow closes it. Also the profile menu
// that opens from the avatar in the top bar (chat plan 9.9).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, Icon, IconButton } from "widgets.slint";
import { SettingsStore, SFind } from "settings_store.slint";
import { SButton, SFont, SNavItem } from "settings_widgets.slint";
import { AboutPage, AccessibilityPage, AccountsPage, AppearancePage, DevicesPage, FilesPage, GeneralPage, NotificationsPage, PermissionsPage, PrivacyPage } from "settings_pages.slint";

export { SettingsStore, SOption, SToggle, SNotify, SPerson, SAccount, SOrg, SDevice, SAppPerm, SFind } from "settings_store.slint";

export component SettingsPage inherits Rectangle {
    background: Theme.main;
    // Swallow clicks so the views underneath do not get them.
    TouchArea { }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if SettingsStore.query != "" {
                    SettingsStore.query = "";
                    find-input.text = "";
                } else {
                    SettingsStore.close();
                }
                return accept;
            }
            if (event.text == "f" || event.text == "F") && event.modifiers.control && event.modifiers.alt {
                find-input.focus();
                return accept;
            }
            reject
        }
        HorizontalLayout {
            // The page list.
            Rectangle {
                width: 260px;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 40px;
                        IconButton {
                            icon: @image-url("icons/back.svg");
                            tooltip: "Close settings";
                            y: 4px;
                            clicked => { SettingsStore.close(); }
                        }
                        Text { text: "Settings"; color: Theme.fg; font-size: SFont.title; font-weight: 700; vertical-alignment: center; }
                    }
                    // Find in Settings.
                    Rectangle {
                        height: max(32px, find-input.preferred-height + 12px);
                        border-radius: 4px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: find-input.has-focus ? Theme.accent : Theme.border;
                        Icon { x: 8px; source: @image-url("icons/search.svg"); width: 16px; height: 16px; }
                        find-input := TextInput {
                            x: 32px;
                            width: parent.width - 40px;
                            color: Theme.fg;
                            font-size: SFont.body;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-role: text-input;
                            accessible-label: "Find in Settings";
                            edited => { SettingsStore.query = self.text; SettingsStore.command("query", self.text); }
                        }
                        if find-input.text == "": Text {
                            x: 32px;
                            text: "Find in Settings (Ctrl+Alt+F)";
                            color: Theme.fg-subtle;
                            font-size: SFont.body;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 6px; }
                    for p in [
                        {key: "general", label: "General", icon: @image-url("icons/home.svg")},
                        {key: "accounts", label: "Accounts and orgs", icon: @image-url("icons/users.svg")},
                        {key: "privacy", label: "Privacy", icon: @image-url("icons/lock.svg")},
                        {key: "notifications", label: "Notifications and activity", icon: @image-url("icons/activity.svg")},
                        {key: "appearance", label: "Appearance", icon: @image-url("icons/eye.svg")},
                        {key: "accessibility", label: "Accessibility", icon: @image-url("icons/people.svg")},
                        {key: "devices", label: "Devices", icon: @image-url("icons/video.svg")},
                        {key: "files", label: "Files and links", icon: @image-url("icons/file.svg")},
                        {key: "permissions", label: "App permissions", icon: @image-url("icons/shortcut.svg")},
                    ]: SNavItem {
                        label: p.label;
                        icon: p.icon;
                        active: SettingsStore.query == "" && SettingsStore.page == p.key;
                        clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = p.key; SettingsStore.command("page", p.key); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    SNavItem {
                        label: "About";
                        icon: @image-url("icons/info.svg");
                        active: SettingsStore.query == "" && SettingsStore.page == "about";
                        clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = "about"; SettingsStore.command("page", "about"); }
                    }
                }
            }
            // The open page, or the search results.
            VerticalLayout {
                horizontal-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        padding-right: 32px;
                        spacing: 12px;
                        alignment: start;
                        if SettingsStore.query != "": VerticalLayout {
                            spacing: 6px;
                            Text { text: "Results for \"" + SettingsStore.query + "\""; color: Theme.fg; font-size: SFont.title; font-weight: 700; }
                            if SettingsStore.found.length == 0: Text { text: "No setting matches."; color: Theme.fg-muted; font-size: SFont.body; }
                            for f in SettingsStore.found: Rectangle {
                                height: max(40px, fr.preferred-height + 12px);
                                border-radius: 4px;
                                background: ft.has-hover ? Theme.surface-hover : Theme.surface;
                                accessible-role: button;
                                accessible-label: "Result: " + f.label + " in " + f.page-title;
                                accessible-action-default => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = f.page; SettingsStore.command("page", f.page); }
                                fr := VerticalLayout {
                                    padding-left: 12px;
                                    alignment: center;
                                    Text { text: f.label; color: Theme.fg; font-size: SFont.body; }
                                    Text { text: f.page-title; color: Theme.fg-subtle; font-size: SFont.small; }
                                }
                                ft := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = f.page; SettingsStore.command("page", f.page); }
                                }
                            }
                        }
                        if SettingsStore.query == "": Text {
                            text: SettingsStore.page == "general" ? "General" : SettingsStore.page == "accounts" ? "Accounts and orgs" : SettingsStore.page == "privacy" ? "Privacy" : SettingsStore.page == "notifications" ? "Notifications and activity" : SettingsStore.page == "appearance" ? "Appearance" : SettingsStore.page == "accessibility" ? "Accessibility" : SettingsStore.page == "devices" ? "Devices" : SettingsStore.page == "files" ? "Files and links" : SettingsStore.page == "permissions" ? "App permissions" : "About";
                            color: Theme.fg;
                            font-size: SFont.title;
                            font-weight: 700;
                            accessible-role: text;
                            accessible-label: "Settings page";
                            accessible-value: self.text;
                        }
                        if SettingsStore.query == "" && SettingsStore.page == "general": GeneralPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "accounts": AccountsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "privacy": PrivacyPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "notifications": NotificationsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "appearance": AppearancePage { }
                        if SettingsStore.query == "" && SettingsStore.page == "accessibility": AccessibilityPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "devices": DevicesPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "files": FilesPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "permissions": PermissionsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "about": AboutPage { }
                    }
                }
                if SettingsStore.notice != "": Rectangle {
                    height: max(36px, nt.preferred-height + 14px);
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: text;
                    accessible-label: "Settings notice";
                    accessible-value: SettingsStore.notice;
                    nt := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: SettingsStore.notice;
                        color: Theme.fg;
                        font-size: SFont.small;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    init => { keys.focus(); }
}

// The profile menu under the avatar: who is signed in, the status message (read-only here), and
// Settings, View account and Sign out.
export component ProfileMenu inherits Rectangle {
    // Clicking outside closes it.
    TouchArea { clicked => { SettingsStore.profile-open = false; SettingsStore.confirm-sign-out = false; } }
    menu-keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { SettingsStore.profile-open = false; return accept; }
            reject
        }
    }
    init => { menu-keys.focus(); }
    panel := Rectangle {
        x: root.width - self.width - 8px;
        y: 46px;
        width: 300px;
        height: col.preferred-height;
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        accessible-role: groupbox;
        accessible-label: "Your profile";
        TouchArea { }
        col := VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Avatar { initials: SettingsStore.me-initials; size: 48px; }
                VerticalLayout {
                    alignment: center;
                    Text { text: SettingsStore.me-name; color: Theme.fg; font-size: SFont.heading; font-weight: 600; overflow: elide; accessible-role: text; accessible-label: "Name"; accessible-value: self.text; }
                    Text { text: SettingsStore.me-email; color: Theme.fg-muted; font-size: SFont.small; overflow: elide; accessible-role: text; accessible-label: "Email"; accessible-value: self.text; }
                    if SettingsStore.me-presence != "": Text { text: SettingsStore.me-presence; color: Theme.fg-muted; font-size: SFont.small; }
                }
            }
            Rectangle {
                height: max(34px, sm.preferred-height + 12px);
                border-radius: 4px;
                background: Theme.main;
                accessible-role: text;
                accessible-label: "Status message";
                accessible-value: SettingsStore.me-status;
                sm := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: SettingsStore.me-status != "" ? SettingsStore.me-status : "No status message";
                    color: SettingsStore.me-status != "" ? Theme.fg : Theme.fg-subtle;
                    font-size: SFont.body;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            SButton { label: "Change profile photo (not available yet)"; enabled: false; }
            SButton { label: "Settings"; clicked => { SettingsStore.show("general"); } }
            SButton { label: "View account"; clicked => { SettingsStore.command("view-account", ""); } }
            if !SettingsStore.confirm-sign-out: SButton { label: "Sign out"; clicked => { SettingsStore.confirm-sign-out = true; } }
            if SettingsStore.confirm-sign-out: VerticalLayout {
                spacing: 6px;
                Text { text: "Sign out of kelma on this computer? kelma closes; open it again to sign in."; color: Theme.fg; font-size: SFont.small; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SButton { label: "Cancel"; clicked => { SettingsStore.confirm-sign-out = false; } }
                    SButton { label: "Yes, sign out"; danger: true; clicked => { SettingsStore.confirm-sign-out = false; SettingsStore.command("sign-out", ""); } }
                }
            }
        }
    }
}
