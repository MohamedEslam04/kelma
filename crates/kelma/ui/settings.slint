// The Settings page (plans/settings-and-platform.md X1.1): a list of pages on the left with
// "Find in Settings" (Ctrl+Alt+F) on top and About at the bottom, the open page on the right.
// It covers the area right of the rail; Esc or the back arrow closes it. Also the profile menu
// that opens from the avatar in the top bar (chat plan 9.9).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, Icon, IconButton } from "widgets.slint";
import { SettingsStore, SFind } from "settings_store.slint";
import { SButton, SField, SFont, SNavItem, SRadio, SSwitch, ZoomRow } from "settings_widgets.slint";
import { AboutPage, AccessibilityPage, AccountsPage, AppearancePage, CallsSettingsPage, ChatsPage, DevicesPage, FilesPage, GeneralPage, NotificationsPage, PermissionsPage, PrivacyPage } from "settings_pages.slint";

export { SettingsStore, SOption, SToggle, SNotify, SPerson, SAccount, SOrg, SDevice, SAppPerm, SFind } from "settings_store.slint";

export component SettingsPage inherits Rectangle {
    background: Theme.main;
    // A narrow window: a narrower page list and less padding, so the pages keep their room.
    property <bool> narrow: root.width < 800px;
    // Chats › "Press Enter to send": the composer's own setting, kept by the window.
    in property <bool> enter-sends: true;
    callback set-enter-sends(bool);
    // A Find result opened a page: the row of that setting reports its place (settings_widgets),
    // and the page scrolls it into view.
    property <length> want-y: SettingsStore.target-y;
    changed want-y => {
        if self.want-y >= 0 {
            sv.content-y = -clamp(self.want-y - sv.absolute-position.y - sv.content-y - 24px, 0px, max(0px, sv.content-height - sv.height));
            SettingsStore.target-y = -1px;
        }
    }
    // Swallow clicks so the views underneath do not get them.
    TouchArea { }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if SettingsStore.query != "" {
                    SettingsStore.query = "";
                    find-input.text = "";
                } else {
                    SettingsStore.close();
                }
                return accept;
            }
            if (event.text == "f" || event.text == "F") && event.modifiers.control && event.modifiers.alt {
                find-input.focus();
                return accept;
            }
            reject
        }
        HorizontalLayout {
            // The page list.
            Rectangle {
                width: root.narrow ? 200px : 260px;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 40px;
                        IconButton {
                            icon: @image-url("icons/back.svg");
                            tooltip: @tr("Close settings");
                            y: 4px;
                            clicked => { SettingsStore.close(); }
                        }
                        Text { text: @tr("Settings"); color: Theme.fg; font-size: SFont.title; font-weight: 700; vertical-alignment: center; }
                    }
                    // Find in Settings.
                    Rectangle {
                        height: max(32px, find-input.preferred-height + 12px);
                        border-radius: 4px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: find-input.has-focus ? Theme.accent : Theme.border;
                        Icon { x: 8px; source: @image-url("icons/search.svg"); width: 16px; height: 16px; }
                        find-input := TextInput {
                            x: 32px;
                            width: parent.width - 40px;
                            color: Theme.fg;
                            font-size: SFont.body;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-role: text-input;
                            accessible-label: @tr("Find in Settings");
                            edited => { SettingsStore.query = self.text; SettingsStore.command("query", self.text); }
                        }
                        if find-input.text == "": Text {
                            x: 32px;
                            width: parent.width - 40px;
                            overflow: elide;
                            text: @tr("Find in Settings (Ctrl+Alt+F)");
                            color: Theme.fg-subtle;
                            font-size: SFont.body;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 6px; }
                    for p in [
                        {key: "general", label: @tr("General"), icon: @image-url("icons/home.svg")},
                        {key: "chats", label: @tr("Chats and channels"), icon: @image-url("icons/chat.svg")},
                        {key: "accounts", label: @tr("Accounts and orgs"), icon: @image-url("icons/users.svg")},
                        {key: "privacy", label: @tr("Privacy"), icon: @image-url("icons/lock.svg")},
                        {key: "notifications", label: @tr("Notifications and activity"), icon: @image-url("icons/activity.svg")},
                        {key: "appearance", label: @tr("Appearance"), icon: @image-url("icons/eye.svg")},
                        {key: "accessibility", label: @tr("Accessibility"), icon: @image-url("icons/people.svg")},
                        {key: "devices", label: @tr("Devices"), icon: @image-url("icons/video.svg")},
                        {key: "calls", label: @tr("Calls"), icon: @image-url("icons/call-direct.svg")},
                        {key: "files", label: @tr("Files and links"), icon: @image-url("icons/file.svg")},
                        {key: "permissions", label: @tr("App permissions"), icon: @image-url("icons/shortcut.svg")},
                    ]: SNavItem {
                        label: p.label;
                        icon: p.icon;
                        active: SettingsStore.query == "" && SettingsStore.page == p.key;
                        clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = p.key; SettingsStore.command("page", p.key); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    SNavItem {
                        label: @tr("About");
                        icon: @image-url("icons/info.svg");
                        active: SettingsStore.query == "" && SettingsStore.page == "about";
                        clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.page = "about"; SettingsStore.command("page", "about"); }
                    }
                }
            }
            // The open page, or the search results.
            VerticalLayout {
                horizontal-stretch: 1;
                sv := ScrollView {
                    VerticalLayout {
                        padding: root.narrow ? 16px : 24px;
                        padding-right: root.narrow ? 16px : 32px;
                        spacing: 12px;
                        alignment: start;
                        if SettingsStore.query != "": VerticalLayout {
                            spacing: 6px;
                            Text { horizontal-alignment: Theme.start-align; text: @tr("Results for \"{}\"", SettingsStore.query); color: Theme.fg; font-size: SFont.title; font-weight: 700; }
                            if SettingsStore.found.length == 0: Text { horizontal-alignment: Theme.start-align; text: @tr("No setting matches."); color: Theme.fg-muted; font-size: SFont.body; }
                            for f in SettingsStore.found: Rectangle {
                                height: max(40px, fr.preferred-height + 12px);
                                border-radius: 4px;
                                background: ft.has-hover ? Theme.surface-hover : Theme.surface;
                                accessible-role: button;
                                accessible-label: @tr("Result: {} in {}", f.label, f.page-title);
                                accessible-action-default => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.target = f.label; SettingsStore.page = f.page; SettingsStore.command("page", f.page); }
                                fr := VerticalLayout {
                                    padding-left: 12px;
                                    alignment: center;
                                    Text { horizontal-alignment: Theme.start-align; text: f.label; color: Theme.fg; font-size: SFont.body; }
                                    Text { horizontal-alignment: Theme.start-align; text: f.page-title; color: Theme.fg-subtle; font-size: SFont.small; }
                                }
                                ft := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SettingsStore.query = ""; find-input.text = ""; SettingsStore.target = f.label; SettingsStore.page = f.page; SettingsStore.command("page", f.page); }
                                }
                            }
                        }
                        if SettingsStore.query == "": Text {
                            horizontal-alignment: Theme.start-align;
                            text: SettingsStore.page == "general" ? @tr("General") : SettingsStore.page == "chats" ? @tr("Chats and channels") : SettingsStore.page == "accounts" ? @tr("Accounts and orgs") : SettingsStore.page == "privacy" ? @tr("Privacy") : SettingsStore.page == "notifications" ? @tr("Notifications and activity") : SettingsStore.page == "appearance" ? @tr("Appearance") : SettingsStore.page == "accessibility" ? @tr("Accessibility") : SettingsStore.page == "devices" ? @tr("Devices") : SettingsStore.page == "calls" ? @tr("Calls") : SettingsStore.page == "files" ? @tr("Files and links") : SettingsStore.page == "permissions" ? @tr("App permissions") : @tr("About");
                            color: Theme.fg;
                            font-size: SFont.title;
                            font-weight: 700;
                            accessible-role: text;
                            accessible-label: @tr("Settings page");
                            accessible-value: self.text;
                        }
                        if SettingsStore.query == "" && SettingsStore.page == "general": GeneralPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "chats": ChatsPage {
                            enter-sends: root.enter-sends;
                            set-enter-sends(on) => { root.set-enter-sends(on); }
                        }
                        if SettingsStore.query == "" && SettingsStore.page == "accounts": AccountsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "privacy": PrivacyPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "notifications": NotificationsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "appearance": AppearancePage { }
                        if SettingsStore.query == "" && SettingsStore.page == "accessibility": AccessibilityPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "devices": DevicesPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "calls": CallsSettingsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "files": FilesPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "permissions": PermissionsPage { }
                        if SettingsStore.query == "" && SettingsStore.page == "about": AboutPage { }
                    }
                }
                if SettingsStore.notice != "": Rectangle {
                    height: max(36px, nt.preferred-height + 14px);
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: text;
                    accessible-label: @tr("Settings notice");
                    accessible-value: SettingsStore.notice;
                    nt := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: SettingsStore.notice;
                        color: Theme.fg;
                        font-size: SFont.small;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    init => { keys.focus(); }
}

// A Teams availability's icon: green (Available), red (Busy), red with a bar (Do not disturb),
// yellow with a clock (Be right back), yellow (Away), a grey ring (Offline).
component PresenceIcon inherits Rectangle {
    in property <string> status;
    property <color> tone: (status == "Available" || status == "AvailableIdle") ? #6bb700
        : (status == "Busy" || status == "BusyIdle" || status == "DoNotDisturb") ? #c4314b
        : (status == "BeRightBack" || status == "Away") ? #ffaa44
        : #8a8886;
    property <bool> ring: status == "Offline" || status == "";
    in property <length> size: 14px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.ring ? transparent : root.tone;
    border-width: root.ring ? max(1.5px, root.size / 7) : 0px;
    border-color: root.tone;
    // Do not disturb: a white bar across.
    if root.status == "DoNotDisturb": Rectangle {
        x: root.size * 0.22;
        y: root.size * 0.43;
        width: root.size * 0.56;
        height: root.size * 0.14;
        background: #ffffff;
    }
    // Be right back: the hands of a clock.
    if root.status == "BeRightBack": Rectangle {
        x: root.size * 0.43;
        y: root.size * 0.22;
        width: root.size * 0.14;
        height: root.size * 0.35;
        background: #ffffff;
    }
    if root.status == "BeRightBack": Rectangle {
        x: root.size * 0.43;
        y: root.size * 0.43;
        width: root.size * 0.33;
        height: root.size * 0.14;
        background: #ffffff;
    }
}

// The words for a Teams availability, as the profile menu shows them.
global PresenceWords {
    pure public function label(p: string) -> string {
        if p == "Available" || p == "AvailableIdle" { return @tr("Available"); }
        if p == "Busy" || p == "BusyIdle" { return @tr("Busy"); }
        if p == "DoNotDisturb" { return @tr("Do not disturb"); }
        if p == "BeRightBack" { return @tr("Be right back"); }
        if p == "Away" { return @tr("Away"); }
        if p == "Offline" { return @tr("Offline"); }
        if p == "PresenceUnknown" { return @tr("Status unknown"); }
        return p;
    }
}

// One status of "Set status": its icon, its name and a check on the current one.
component StatusRow inherits Rectangle {
    in property <string> label;
    in property <string> status;
    in property <bool> current;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: t.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.current ? @tr("Current status") : "";
    accessible-action-default => { root.clicked(); }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        alignment: stretch;
        if root.status != "": PresenceIcon { status: root.status; y: (parent.height - self.height) / 2; }
        if root.status == "": Icon { source: @image-url("icons/restore.svg"); width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
        Text { text: root.label; color: Theme.fg; font-size: SFont.body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: none; }
        if root.current: Icon { source: @image-url("icons/check.svg"); tint: Theme.accent; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
    }
}

// The profile menu under the avatar: who is signed in (with the photo), Set status (when it ends,
// the status message and when that clears), Change profile photo, Saved, Zoom, Keyboard shortcuts,
// Settings, View account and Sign out.
export component ProfileMenu inherits Rectangle {
    callback open-saved();
    callback open-shortcuts();
    // How tall the panel is (app.slint `pointer-pressed` knows its place).
    out property <length> panel-height: panel.height;
    // The "Set work location" and "Pause notifications" choices are showing.
    property <bool> location-open: false;
    property <bool> pause-open: false;
    // Clicking outside closes it.
    TouchArea { clicked => { SettingsStore.profile-open = false; SettingsStore.confirm-sign-out = false; } }
    menu-keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { SettingsStore.profile-open = false; return accept; }
            reject
        }
    }
    init => { menu-keys.focus(); }
    panel := Rectangle {
        x: root.width - self.width - 8px;
        y: 46px;
        width: 300px;
        // Never taller than the window: the rest scrolls (the status options are long).
        height: max(0px, min(col.preferred-height, root.height - 56px));
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        accessible-role: groupbox;
        accessible-label: @tr("Your profile");
        clip: true;
        TouchArea { }
        ScrollView {
            width: parent.width;
            height: parent.height;
            // The whole menu can be scrolled to, whatever the layout's minimum height says.
            content-height: max(self.visible-height, col.preferred-height);
            col := VerticalLayout {
                padding: 14px;
                padding-right: 18px;
                spacing: 8px;
                // Teams' first line: the organisation, and Sign out.
                HorizontalLayout {
                    spacing: 8px;
                    for o in SettingsStore.orgs: HorizontalLayout {
                        if o.active: Text {
                            text: o.name;
                            color: Theme.fg-muted;
                            font-size: SFont.small;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: text;
                            accessible-label: @tr("Organisation");
                            accessible-value: self.text;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: sign-out-text.preferred-width;
                        accessible-role: button;
                        accessible-label: @tr("Sign out of kelma");
                        accessible-action-default => { SettingsStore.confirm-sign-out = true; }
                        sign-out-text := Text { text: @tr("Sign out"); color: Theme.accent; font-size: SFont.small; vertical-alignment: center; accessible-role: none; }
                        TouchArea { mouse-cursor: pointer; clicked => { SettingsStore.confirm-sign-out = true; } }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Avatar {
                        initials: SettingsStore.me-initials;
                        img: SettingsStore.me-photo;
                        has-img: SettingsStore.me-has-photo;
                        size: 48px;
                        presence: SettingsStore.me-presence;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: SettingsStore.me-name; color: Theme.fg; font-size: SFont.heading; font-weight: 600; overflow: elide; accessible-role: text; accessible-label: @tr("Name"); accessible-value: self.text; }
                        Text { text: SettingsStore.me-email; color: Theme.fg-muted; font-size: SFont.small; overflow: elide; accessible-role: text; accessible-label: @tr("Email"); accessible-value: self.text; }
                        if SettingsStore.me-presence != "": HorizontalLayout {
                            spacing: 6px;
                            PresenceIcon { status: SettingsStore.me-presence; size: 10px; y: (parent.height - self.height) / 2; }
                            Text { text: PresenceWords.label(SettingsStore.me-presence); color: Theme.fg-muted; font-size: SFont.small; overflow: elide; horizontal-stretch: 1; accessible-role: text; accessible-label: @tr("Status"); accessible-value: self.text; }
                        }
                        // When a status picked with "Reset status after" ends.
                        if SettingsStore.me-presence-until != "": Text { text: SettingsStore.me-presence-until; color: Theme.fg-subtle; font-size: SFont.small; overflow: elide; accessible-role: text; accessible-label: @tr("Status ends"); accessible-value: self.text; }
                        if SettingsStore.me-work-location != "": Text {
                            text: SettingsStore.me-work-location == "office" ? @tr("In the office today") : @tr("Working remotely today");
                            color: Theme.fg-muted;
                            font-size: SFont.small;
                            accessible-role: text;
                            accessible-label: @tr("Work location");
                            accessible-value: self.text;
                        }
                    }
                }
                Rectangle {
                    height: max(34px, sm.preferred-height + 12px);
                    border-radius: 4px;
                    background: Theme.main;
                    accessible-role: text;
                    accessible-label: @tr("Status message");
                    accessible-value: SettingsStore.me-status;
                    sm := Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: SettingsStore.me-status != "" ? SettingsStore.me-status : @tr("No status message");
                        color: SettingsStore.me-status != "" ? Theme.fg : Theme.fg-subtle;
                        font-size: SFont.body;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                SButton {
                    label: SettingsStore.status-open ? @tr("Hide status options") : @tr("Set status");
                    clicked => { SettingsStore.status-open = !SettingsStore.status-open; }
                }
                if SettingsStore.status-open: VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("Reset status after"); color: Theme.fg-muted; font-size: SFont.small; }
                    Text { text: @tr("Choose this first: the status you pick lasts that long."); color: Theme.fg-subtle; font-size: SFont.small; wrap: word-wrap; }
                    for d in [{v: "never", l: @tr("Never")}, {v: "30m", l: @tr("30 minutes")}, {v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "today", l: @tr("Today")}, {v: "week", l: @tr("This week")}, {v: "custom", l: @tr("Custom")}]: SRadio {
                        group: @tr("Reset status after");
                        label: d.l;
                        checked: SettingsStore.status-duration == d.v;
                        picked => { SettingsStore.status-duration = d.v; }
                    }
                    if SettingsStore.status-duration == "custom": SField {
                        label: @tr("Reset at");
                        placeholder: "2026-12-31 17:30";
                        initial: SettingsStore.status-custom;
                        edited(t) => { SettingsStore.status-custom = t; }
                    }
                    for st in [{v: "Available", l: @tr("Available")}, {v: "Busy", l: @tr("Busy")}, {v: "DoNotDisturb", l: @tr("Do not disturb")}, {v: "BeRightBack", l: @tr("Be right back")}, {v: "Away", l: @tr("Appear away")}, {v: "Offline", l: @tr("Appear offline")}]: StatusRow {
                        label: st.l;
                        status: st.v;
                        current: SettingsStore.me-presence == st.v || SettingsStore.me-presence == st.v + "Idle";
                        clicked => { SettingsStore.command("status", st.v); }
                    }
                    StatusRow { label: @tr("Reset status"); status: ""; clicked => { SettingsStore.command("status", ""); } }
                    note := SField { label: @tr("New status message"); initial: SettingsStore.me-status; }
                    Text { text: @tr("Clear message after"); color: Theme.fg-muted; font-size: SFont.small; }
                    for d in [{v: "never", l: @tr("Never")}, {v: "today", l: @tr("Today")}, {v: "1h", l: @tr("1 hour")}, {v: "4h", l: @tr("4 hours")}, {v: "week", l: @tr("This week")}]: SRadio {
                        group: @tr("Clear message after");
                        label: d.l;
                        checked: SettingsStore.note-clear-after == d.v;
                        picked => { SettingsStore.note-clear-after = d.v; }
                    }
                    SSwitch {
                        label: @tr("Show when people message me");
                        on: SettingsStore.note-show-when-messaged;
                        toggled(on) => { SettingsStore.note-show-when-messaged = on; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SButton { label: @tr("Save message"); clicked => { SettingsStore.command("status-note", note.text); } }
                        SButton { label: @tr("Clear message"); clicked => { SettingsStore.command("status-note", ""); } }
                    }
                }
                // Teams' "Set work location ›" (the same write as the calendar's; UNVERIFIED).
                SButton { label: @tr("Set work location"); clicked => { root.location-open = !root.location-open; } }
                if root.location-open: HorizontalLayout {
                    spacing: 6px;
                    SButton { label: @tr("In the office"); clicked => { root.location-open = false; SettingsStore.command("work-location", "office"); } }
                    SButton { label: @tr("Remote"); clicked => { root.location-open = false; SettingsStore.command("work-location", "remote"); } }
                    SButton { label: @tr("Clear location"); clicked => { root.location-open = false; SettingsStore.command("work-location", "clear"); } }
                }
                // Teams' "Pause notifications ›": the same pause as Settings › Notifications.
                SButton { label: SettingsStore.paused ? @tr("Pause notifications ({})", SettingsStore.pause-until != "" ? SettingsStore.pause-until : @tr("paused")) : @tr("Pause notifications"); accessible-label: @tr("Pause notifications"); clicked => { root.pause-open = !root.pause-open; } }
                if root.pause-open: VerticalLayout {
                    spacing: 4px;
                    for p in [{v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "tomorrow", l: @tr("Until tomorrow")}, {v: "off", l: @tr("Turn off the pause")}]: SButton {
                        label: p.l;
                        clicked => { root.pause-open = false; SettingsStore.command("pause", p.v); }
                    }
                }
                SButton { label: @tr("Change profile photo"); clicked => { SettingsStore.command("photo-change", ""); } }
                if SettingsStore.me-has-photo: SButton { label: @tr("Remove photo"); clicked => { SettingsStore.command("photo-remove", ""); } }
                SButton { label: @tr("Saved"); clicked => { root.open-saved(); } }
                ZoomRow { }
                SButton { label: @tr("Keyboard shortcuts"); clicked => { root.open-shortcuts(); } }
                SButton { label: @tr("Settings"); clicked => { SettingsStore.show("general"); } }
                SButton { label: @tr("View account"); clicked => { SettingsStore.command("view-account", ""); } }
                if !SettingsStore.confirm-sign-out: SButton { label: @tr("Sign out"); clicked => { SettingsStore.confirm-sign-out = true; } }
                if SettingsStore.confirm-sign-out: VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("Sign out of kelma on this computer? kelma closes; open it again to sign in."); color: Theme.fg; font-size: SFont.small; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        SButton { label: @tr("Cancel"); clicked => { SettingsStore.confirm-sign-out = false; } }
                        SButton { label: @tr("Yes, sign out"); danger: true; clicked => { SettingsStore.confirm-sign-out = false; SettingsStore.command("sign-out", ""); } }
                    }
                }
                // What the photo, the status or a refused change answered.
                if SettingsStore.notice != "": Text {
                    text: SettingsStore.notice;
                    color: Theme.fg-muted;
                    font-size: SFont.small;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: @tr("Profile notice");
                    accessible-value: self.text;
                }
            }
        }
    }
}
