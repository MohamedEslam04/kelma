export struct ChatRow {
    id: string,
    title: string,
    preview: string,
    time: string,
    unread: bool,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    section: string, // "favorites" | "chats" | "channels"
    rtl-title: bool,
    rtl-preview: bool,
    favorite: bool,
    draft: bool, // preview is an unsent draft
    mention: bool, // an unread message mentions me
    group: bool,   // a group chat (the item menu offers Leave)
    muted: bool,   // notifications are off (the item menu offers Unmute)
    channel: bool, // a channel (the item menu offers the channel items)
}

// Adaptive Card rows (plan 8.8). `kind`: text | fact | columns | image | actions | banner.
// `band`: "" | emphasis | good | attention | warning | accent. `tone`: default | dark | light |
// accent | good | warning | attention.
export struct CardCell { text: styled-text, plain: string, stretch: float, size: length, bold: bool, tone: string, img: image, has-img: bool }
export struct CardButton { title: string, url: string }
export struct CardRow {
    kind: string,
    text: styled-text,
    plain: string,
    label: string,
    size: length,
    bold: bool,
    subtle: bool,
    tone: string,
    band: string,
    cells: [CardCell],
    buttons: [CardButton],
    img: image,
    has-img: bool,
    img-w: length,
    img-h: length,
}

export struct ReactionItem { key: string, emoji: string, count: int, mine: bool, names: string }
export struct EmojiItem { key: string, emoji: string, name: string }
export struct Recipient { id: string, title: string, initials: string, color: color, picked: bool }
// One emoji of the composer's emoji panel and `:xx` autocomplete.
export struct ComposerEmoji { ch: string, name: string }
// Result of inserting text into the composer: the new text and where the cursor goes (byte offset).
export struct Edited { text: string, cursor: int }

// An attachment waiting in the composer (pasted image, dropped or picked file).
export struct PendingAttachment { name: string, detail: string, is-image: bool, preview: image, has-preview: bool }
export struct FileItem { name: string, url: string, ext: string }
export struct ImageItem { url: string, img: image, loaded: bool, w: length, h: length }

export struct Msg {
    id: string,
    sender: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    mine: bool,
    time: string,
    day: string,           // non-empty: draw a date separator above
    show-header: bool,     // first message of a run from the same sender
    edited: bool,
    deleted: bool,
    system: bool,          // member added, call ended, ...
    subject: string,
    quote-author: string,
    quote-text: string,
    body: styled-text,
    plain: string,
    rtl: bool,
    images: [ImageItem],
    files: [FileItem],
    reactions: [ReactionItem],
    reply-count: int,
    pending: bool,
    saved: bool,           // in the local saved list
    selected: bool,        // ticked in multi-select mode
    failed: bool,          // could not be sent: show Retry and Delete
    new-above: bool,       // draw the "New messages" divider above this row
    sender-id: string,     // MRI of the sender, for the profile card
    mentions-me: bool,     // the message @mentions me (or everyone)
    receipt: string,       // on my newest message: "" | "sent" | "seen"
    receipt-names: string, // who has seen it
    flash: bool,           // the row a jump (pinned banner) landed on
    card: [CardRow],       // an Adaptive Card drawn like Teams does (empty: show the text body)
    headline: string,      // headline of an announcement post
    importance: string,    // "" | "high" | "urgent": a red IMPORTANT! or URGENT! label
}

// A person (or, for the @mention picker, a team, channel or "Everyone" entry) in a people list.
export struct PersonItem {
    id: string,
    name: string,
    subtitle: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    kind: string, // "person" | "team" | "channel" | "everyone"
}

// One pinned message of the open chat, for the banner.
export struct PinnedItem { id: string, sender: string, preview: string }

export struct ChannelRow { id: string, name: string, unread: bool, hidden: bool }
export struct TeamRow { id: string, name: string, initials: string, color: color, expanded: bool, channels: [ChannelRow] }

export struct ActivityRow {
    id: string,
    title: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    badge: string,      // "@", an emoji, a reply arrow, ...
    unread: bool,
    preview: string,
    time: string,
    location: string,   // "Team › channel" or "In chat with …"
    rtl-preview: bool,
}
