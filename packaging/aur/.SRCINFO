pkgbase = ironteams-git
	pkgdesc = An unofficial native Microsoft Teams client written in Rust
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/MohamedEslam04/teams-in-rust
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	makedepends = pkgconf
	makedepends = cmake
	makedepends = alsa-lib
	depends = fontconfig
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrender
	depends = libglvnd
	optdepends = noto-fonts-emoji: emoji rendering
	optdepends = gnome-keyring: Secret Service for the stored sign-in (or kwallet)
	optdepends = xdg-desktop-portal: file chooser and open-link portals
	optdepends = gst-plugin-pipewire: screen sharing in calls (with gstreamer and gst-plugins-base)
	optdepends = gst-plugins-good: camera video in calls (V4L2 and MJPEG cameras)
	optdepends = ffmpeg: recording voice messages (encodes them to AAC)
	provides = ironteams
	conflicts = ironteams
	options = !lto
	options = !debug
	source = ironteams::git+https://github.com/MohamedEslam04/teams-in-rust.git
	sha256sums = SKIP

pkgname = ironteams-git
