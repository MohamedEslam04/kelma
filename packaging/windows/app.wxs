<!--
  The Windows installer (WiX 5): the program, the Hunspell dictionaries and a Start menu shortcut,
  per machine under Program Files. Built by .github/workflows/release.yml, which passes the name:

    wix build packaging/windows/app.wxs -arch x64 -d Version=0.1.0 -d Stage=stage
        -d AppName=ironteams -d Exe=ironteams.exe -o ironteams.msi

  `Stage` is the folder the release job fills (the .exe, app.ico, LICENSE.txt, dictionaries\).
  The UpgradeCode never changes, also across a rename: a newer MSI replaces the installed one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.AppName)" Manufacturer="$(var.AppName) contributors" Version="$(var.Version)"
           UpgradeCode="e34c59c1-04b5-4785-ace7-df60f5bfd5dc" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.AppName) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="$(var.Stage)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MohamedEslam04/teams-in-rust" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.AppName)">
        <Directory Id="DICTIONARIES" Name="dictionaries" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="$(var.AppName)">
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.Stage)\$(var.Exe)" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.Stage)\LICENSE.txt" />
      </Component>
      <!-- One file per component: WiX only generates GUIDs for single-file components. -->
      <Component Directory="DICTIONARIES">
        <File Source="$(var.Stage)\dictionaries\en_US.aff" />
      </Component>
      <Component Directory="DICTIONARIES">
        <File Source="$(var.Stage)\dictionaries\en_US.dic" />
      </Component>
      <Component Directory="DICTIONARIES">
        <File Source="$(var.Stage)\dictionaries\ar.aff" />
      </Component>
      <Component Directory="DICTIONARIES">
        <File Source="$(var.Stage)\dictionaries\ar.dic" />
      </Component>
      <Component Directory="ProgramMenuFolder">
        <Shortcut Name="$(var.AppName)" Description="An unofficial native Microsoft Teams client written in Rust"
                  Target="[INSTALLFOLDER]$(var.Exe)" WorkingDirectory="INSTALLFOLDER" Icon="app.ico" />
        <RegistryValue Root="HKMU" Key="Software\$(var.AppName)" Name="StartMenuShortcut" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
